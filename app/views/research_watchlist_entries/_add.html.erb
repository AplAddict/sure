<%# locals: (entry:, typed_ticker:) %>
<%# Add-a-ticker form. `entry` is the unsaved ResearchWatchlistEntry (carrying any
    validation errors); `typed_ticker` is what the member typed, kept after a
    failed add so it is not lost. %>
<% statuses = ResearchWatchlistEntry::STATUSES.map { |s| [ t("research_watchlist_entries.index.statuses.#{s}"), s ] } %>
<% field_class = "w-full rounded-lg border border-tertiary bg-container px-3 py-2 text-sm text-primary focus-ring" %>
<div data-testid="watchlist-add">
  <% if entry.errors.any? %>
    <ul class="text-sm text-destructive" role="alert"><% entry.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
  <% end %>
  <%= form_with model: entry, url: research_watchlist_entries_path, class: "mt-3 grid gap-3 md:grid-cols-[8rem_10rem_6rem_1fr_auto]" do |f| %>
    <%= f.text_field :ticker, value: typed_ticker, placeholder: t("research_watchlist_entries.index.ticker"), required: true, maxlength: 20, class: field_class, "aria-label": t("research_watchlist_entries.index.ticker") %>
    <%= f.select :status, statuses, { selected: entry.status }, class: field_class, "aria-label": t("research_watchlist_entries.index.status") %>
    <%= f.select :priority, (1..5).to_a, { selected: entry.priority }, class: field_class, "aria-label": t("research_watchlist_entries.index.priority_label") %>
    <%= f.text_field :thesis, placeholder: t("research_watchlist_entries.index.thesis_placeholder"), maxlength: 2000, class: field_class, "aria-label": t("research_watchlist_entries.index.thesis") %>
    <%= f.submit t("research_watchlist_entries.index.add"), class: "rounded-lg px-4 py-2 text-sm font-medium button-bg-primary text-inverse cursor-pointer" %>
  <% end %>
</div>
