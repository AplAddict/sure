<% content_for :page_title, t(".title") %>
<%= turbo_frame_tag "investment_workspace", target: "_top" do %>
  <div class="mb-6">
    <%= render "investments/subnav", current: :watchlist %>
    <h1 class="text-xl lg:text-3xl font-medium text-primary"><%= t(".title") %></h1>
    <p class="mt-1 max-w-3xl text-sm text-secondary"><%= t(".subtitle") %></p>
  </div>
  <div class="space-y-6 pb-6 lg:pb-12">
  <%= render "investments/sections",
        sections: InvestmentSections.new(namespace: "watchlist", user: Current.user, definitions: [
          { key: "add", title: t(".add_heading"), partial: "research_watchlist_entries/add", locals: { entry: @new_entry, typed_ticker: @typed_ticker } },
          { key: "saved", title: t(".saved"), flush: true, partial: "research_watchlist_entries/saved",
            locals: { entries: @entries, status_counts: @status_counts, status_filter: @status_filter, failed_entry: @failed_entry, fundamentals: @fundamentals } }
        ]),
        namespace: "watchlist",
        url: investment_section_preferences_path("watchlist"), preference_key: "investments_watchlist" %>
</div>
<% end %>
