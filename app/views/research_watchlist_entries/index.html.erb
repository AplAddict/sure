<% content_for :page_title, t(".title") %>
<% statuses = ResearchWatchlistEntry::STATUSES.map { |s| [ t(".statuses.#{s}"), s ] } %>
<% field_class = "w-full rounded-lg border border-tertiary bg-container px-3 py-2 text-sm text-primary focus-ring" %>
<% content_for :page_header do %>
  <div class="mb-6">
    <%= render "investments/subnav", current: :watchlist %>
    <h1 class="text-xl lg:text-3xl font-medium text-primary"><%= t(".title") %></h1>
    <p class="mt-1 max-w-3xl text-sm text-secondary"><%= t(".subtitle") %></p>
  </div>
<% end %>

<%= turbo_frame_tag "investment_workspace" do %>
  <div class="space-y-6 pb-6 lg:pb-12">
  <% if turbo_frame_request? %><%= render "investments/workspace_header", current: :watchlist, title: t(".title"), subtitle: t(".subtitle") %><% end %>
  <section class="rounded-xl bg-container p-4 shadow-border-xs" aria-labelledby="rw-add" data-testid="watchlist-add">
    <h2 id="rw-add" class="text-sm font-medium text-primary"><%= t(".add_heading") %></h2>
    <% if @new_entry.errors.any? %>
      <ul class="mt-2 text-sm text-destructive" role="alert"><% @new_entry.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    <% end %>
    <%= form_with model: @new_entry, url: research_watchlist_entries_path, class: "mt-3 grid gap-3 md:grid-cols-[8rem_10rem_6rem_1fr_auto]" do |f| %>
      <%= f.text_field :ticker, value: @typed_ticker, placeholder: t(".ticker"), required: true, maxlength: 20, class: field_class, "aria-label": t(".ticker") %>
      <%= f.select :status, statuses, { selected: @new_entry.status }, class: field_class, "aria-label": t(".status") %>
      <%= f.select :priority, (1..5).to_a, { selected: @new_entry.priority }, class: field_class, "aria-label": t(".priority_label") %>
      <%= f.text_field :thesis, placeholder: t(".thesis_placeholder"), maxlength: 2000, class: field_class, "aria-label": t(".thesis") %>
      <%= f.submit t(".add"), class: "rounded-lg px-4 py-2 text-sm font-medium button-bg-primary text-inverse cursor-pointer" %>
    <% end %>
  </section>

  <section class="rounded-xl bg-container shadow-border-xs overflow-hidden" aria-label="<%= t(".saved") %>">
    <% if @entries.empty? %>
      <div class="p-6 text-sm text-secondary"><%= t(".empty") %></div>
    <% else %>
      <ul class="divide-y divide-tertiary">
        <% @entries.each do |entry| %>
          <% row = (@failed_entry && @failed_entry.id == entry.id) ? @failed_entry : entry %>
          <li class="p-4" data-testid="watchlist-row-<%= entry.id %>">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <%= link_to entry.security.ticker, research_ticker_path(entry.security.ticker), class: "font-mono font-medium text-primary hover:underline" %>
                <span class="ml-2 text-xs text-secondary"><%= entry.security.name %></span>
                <% if entry.assistant_added? %>
                  <span class="ml-2 rounded-full bg-container-inset px-2 py-0.5 text-xs text-secondary"><%= t(".added_by_assistant") %></span>
                  <% if entry.expires? %>
                    <span class="ml-1 text-xs text-secondary"><%= t(".expires_in", time: distance_of_time_in_words(Time.current, entry.expires_at)) %></span>
                  <% end %>
                <% end %>
              </div>
              <div class="flex items-center gap-3">
                <% if entry.assistant_added? && entry.expires? %>
                  <%= button_to t(".keep"), research_watchlist_entry_path(entry), method: :patch, params: { keep: 1 }, class: "text-xs font-medium text-primary hover:underline cursor-pointer" %>
                <% end %>
                <%= button_to t(".remove"), research_watchlist_entry_path(entry), method: :delete, class: "text-xs font-medium text-secondary hover:text-destructive cursor-pointer", form: { data: { turbo_confirm: t(".confirm_remove", ticker: entry.security.ticker) } } %>
              </div>
            </div>
            <% if row.errors.any? %>
              <ul class="mt-2 text-sm text-destructive" role="alert"><% row.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
            <% end %>
            <%= form_with model: row, url: research_watchlist_entry_path(entry), method: :patch, class: "mt-3 grid gap-3 md:grid-cols-[10rem_6rem_1fr_auto]" do |f| %>
              <%= f.select :status, statuses, {}, class: field_class, "aria-label": t(".status_for", ticker: entry.security.ticker) %>
              <%= f.select :priority, (1..5).to_a, {}, class: field_class, "aria-label": t(".priority_for", ticker: entry.security.ticker) %>
              <%= f.text_field :thesis, maxlength: 2000, class: field_class, "aria-label": t(".thesis_for", ticker: entry.security.ticker) %>
              <%= f.submit t(".save"), class: "rounded-lg border border-tertiary px-4 py-2 text-sm font-medium text-primary cursor-pointer" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
<% end %>
