<% content_for :page_title, "Research Watchlist" %>
<% statuses = ResearchWatchlistEntry::STATUSES.map { |s| [ s.humanize, s ] } %>
<% field_class = "w-full rounded-lg border border-tertiary bg-container px-3 py-2 text-sm text-primary" %>
<% content_for :page_header do %>
  <div class="mb-6">
    <h1 class="text-xl lg:text-3xl font-medium text-primary">Research Watchlist</h1>
    <p class="mt-1 max-w-3xl text-sm text-secondary">Your private thesis queue. Research context only; it does not change holdings, valuations, or trade authority.</p>
  </div>
<% end %>

<div class="space-y-6 pb-6 lg:pb-12">
  <section class="rounded-xl bg-container p-4 shadow-border-xs" aria-labelledby="rw-add">
    <h2 id="rw-add" class="text-sm font-medium text-primary">Add a ticker</h2>
    <% if @entry&.errors&.any? %>
      <ul class="mt-2 text-sm text-destructive" role="alert"><% @entry.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    <% end %>
    <%= form_with model: ResearchWatchlistEntry.new, url: research_watchlist_entries_path, class: "mt-3 grid gap-3 md:grid-cols-[8rem_10rem_6rem_1fr_auto]" do |f| %>
      <%= f.text_field :ticker, placeholder: "Ticker", required: true, maxlength: 20, class: field_class, "aria-label": "Ticker" %>
      <%= f.select :status, statuses, {}, class: field_class, "aria-label": "Status" %>
      <%= f.select :priority, (1..5).to_a, { selected: 3 }, class: field_class, "aria-label": "Priority (1 highest)" %>
      <%= f.text_field :thesis, placeholder: "Thesis or what you need to validate", maxlength: 2000, class: field_class, "aria-label": "Thesis" %>
      <%= f.submit "Add", class: "rounded-lg px-4 py-2 text-sm font-medium button-bg-primary text-inverse cursor-pointer" %>
    <% end %>
  </section>

  <section class="rounded-xl bg-container shadow-border-xs overflow-hidden" aria-label="Saved theses">
    <% if @entries.empty? %>
      <div class="p-6 text-sm text-secondary">No saved research theses yet.</div>
    <% else %>
      <ul class="divide-y divide-tertiary">
        <% @entries.each do |entry| %>
          <li class="p-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <%= link_to entry.security.ticker, research_ticker_path(entry.security.ticker), class: "font-mono font-medium text-primary hover:underline" %>
                <span class="ml-2 text-xs text-secondary"><%= entry.security.name %></span>
              </div>
              <%= button_to "Remove", research_watchlist_entry_path(entry), method: :delete, class: "text-xs font-medium text-secondary hover:text-destructive cursor-pointer", form: { data: { turbo_confirm: "Remove #{entry.security.ticker} from your watchlist?" } } %>
            </div>
            <%= form_with model: entry, url: research_watchlist_entry_path(entry), method: :patch, class: "mt-3 grid gap-3 md:grid-cols-[10rem_6rem_1fr_auto]" do |f| %>
              <%= f.select :status, statuses, {}, class: field_class, "aria-label": "Status for #{entry.security.ticker}" %>
              <%= f.select :priority, (1..5).to_a, {}, class: field_class, "aria-label": "Priority for #{entry.security.ticker}" %>
              <%= f.text_field :thesis, maxlength: 2000, class: field_class, "aria-label": "Thesis for #{entry.security.ticker}" %>
              <%= f.submit "Save", class: "rounded-lg border border-tertiary px-4 py-2 text-sm font-medium text-primary cursor-pointer" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
