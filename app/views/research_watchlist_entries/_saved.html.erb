<%# locals: (entries:, status_counts:, status_filter:, failed_entry:, fundamentals:) %>
<%# The member's saved theses with status filters, cached fundamentals and an
    inline edit form per row. `failed_entry` is the entry whose update just
    failed validation (its row shows the errors and opens its form);
    `fundamentals` maps security_id to SecurityFundamental. Rendered flush. %>
<% scope = "research_watchlist_entries.index" %>
<% statuses = ResearchWatchlistEntry::STATUSES.map { |s| [ t("#{scope}.statuses.#{s}"), s ] } %>
<% field_class = "w-full rounded-lg border border-tertiary bg-container px-3 py-2 text-sm text-primary focus-ring" %>
<div class="overflow-hidden rounded-b-xl">
  <% if status_counts.values.sum.positive? %>
    <nav class="flex flex-wrap gap-2 border-b border-tertiary px-4 py-3" aria-label="<%= t("#{scope}.filters_label") %>" data-testid="watchlist-filters">
      <% [ [ nil, t("#{scope}.all"), status_counts.values.sum ] ].concat(ResearchWatchlistEntry::STATUSES.map { |status| [ status, t("#{scope}.statuses.#{status}"), status_counts[status] ] }).each do |status, label, count| %>
        <%= link_to research_watchlist_entries_path(status: status), class: "rounded-lg border border-tertiary px-3 py-1 text-xs font-medium focus-ring #{status_filter == status ? "bg-container-inset text-primary" : "text-secondary"}", aria: { current: (status_filter == status ? "true" : nil) } do %>
          <%= label %> <span class="tabular-nums text-secondary"><%= count %></span>
        <% end %>
      <% end %>
    </nav>
  <% end %>
  <% if entries.empty? %>
    <div class="p-6 text-sm text-secondary"><%= status_filter ? t("#{scope}.empty_filtered") : t("#{scope}.empty") %></div>
  <% else %>
    <ul class="divide-y divide-tertiary">
      <% entries.each do |entry| %>
        <% row = (failed_entry && failed_entry.id == entry.id) ? failed_entry : entry %>
        <li class="p-4" data-testid="watchlist-row-<%= entry.id %>">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <%= link_to entry.security.ticker, research_ticker_path(entry.security.ticker), class: "font-mono font-medium text-primary hover:underline" %>
              <span class="ml-2 text-xs text-secondary"><%= entry.security.name %></span>
              <% if entry.assistant_added? %>
                <span class="ml-2 rounded-full bg-container-inset px-2 py-0.5 text-xs text-secondary"><%= t("#{scope}.added_by_assistant") %></span>
                <% if entry.expires? %>
                  <span class="ml-1 text-xs text-secondary"><%= t("#{scope}.expires_in", time: distance_of_time_in_words(Time.current, entry.expires_at)) %></span>
                <% end %>
              <% end %>
            </div>
            <div class="flex items-center gap-3">
              <% if entry.assistant_added? && entry.expires? %>
                <%= button_to t("#{scope}.keep"), research_watchlist_entry_path(entry), method: :patch, params: { keep: 1 }, class: "text-xs font-medium text-primary hover:underline cursor-pointer" %>
              <% end %>
              <%= button_to t("#{scope}.remove"), research_watchlist_entry_path(entry), method: :delete, class: "text-xs font-medium text-secondary hover:text-destructive cursor-pointer", form: { data: { turbo_confirm: t("#{scope}.confirm_remove", ticker: entry.security.ticker) } } %>
            </div>
          </div>
          <% if row.errors.any? %>
            <ul class="mt-2 text-sm text-destructive" role="alert"><% row.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
          <% end %>
          <% fundamental = fundamentals[entry.security_id] %>
          <% data = fundamental&.available? ? fundamental : nil %>
          <% earnings = data && (Date.parse(data.next_earnings_date.to_s) rescue nil) %>
          <% days = earnings && (earnings - Date.current).to_i %>
          <% upcoming = days && days >= 0 ? days : nil %>
          <% money = ->(value) { value.nil? ? "—" : format_money(Money.new(value, data&.currency.presence || "USD")) } %>
          <dl class="mt-3 grid grid-cols-2 gap-x-6 gap-y-2 text-xs sm:grid-cols-4">
            <div><dt class="text-secondary"><%= t("#{scope}.next_earnings") %></dt>
              <dd class="mt-0.5 text-primary" data-testid="watchlist-earnings"><%= upcoming ? "#{l(earnings, format: :short)} · #{t("#{scope}.earnings_in", count: upcoming)}" : "—" %>
                <% if upcoming && upcoming <= 7 %><span class="ml-1" data-testid="watchlist-earnings-soon"><%= render DS::Pill.new(label: t("#{scope}.earnings_soon"), tone: :warning, marker: false, size: :sm) %></span><% end %></dd></div>
            <div><dt class="text-secondary"><%= t("#{scope}.analyst_target") %></dt>
              <dd class="mt-0.5 font-mono text-primary" data-testid="watchlist-target"><%= money.call(data&.target_mean_price) %></dd></div>
            <div><dt class="text-secondary"><%= t("#{scope}.range_52w") %></dt>
              <dd class="mt-0.5 font-mono text-primary" data-testid="watchlist-range"><%= data && data.fifty_two_week_low && data.fifty_two_week_high ? "#{money.call(data.fifty_two_week_low)} – #{money.call(data.fifty_two_week_high)}" : "—" %></dd></div>
            <div><dt class="text-secondary"><%= t("#{scope}.data_label") %></dt>
              <dd class="mt-0.5 text-secondary" data-testid="watchlist-data-age" title="<%= data ? l(data.fetched_at, format: :long) : "" %>"><%= data ? t("#{scope}.data_age", time: time_ago_in_words(data.fetched_at)) : t("#{scope}.no_data") %><% if data&.stale? %> · <%= t("#{scope}.data_stale") %><% end %></dd></div>
          </dl>
          <% if entry.thesis.present? %>
            <p class="mt-3 text-sm text-primary" data-testid="watchlist-thesis"><%= entry.thesis %></p>
          <% end %>
          <details class="mt-3" <%= "open" if row.errors.any? %>>
            <summary class="inline-flex cursor-pointer select-none items-center gap-1 text-xs font-medium text-link hover:underline focus-ring rounded"><%= t("#{scope}.edit") %></summary>
            <%= form_with model: row, url: research_watchlist_entry_path(entry), method: :patch, class: "mt-3 grid gap-3 md:grid-cols-[10rem_6rem_1fr_auto]" do |f| %>
              <%= f.select :status, statuses, {}, class: field_class, "aria-label": t("#{scope}.status_for", ticker: entry.security.ticker) %>
              <%= f.select :priority, (1..5).to_a, {}, class: field_class, "aria-label": t("#{scope}.priority_for", ticker: entry.security.ticker) %>
              <%= f.text_field :thesis, maxlength: 2000, class: field_class, "aria-label": t("#{scope}.thesis_for", ticker: entry.security.ticker) %>
              <%= f.submit t("#{scope}.save"), class: "rounded-lg border border-tertiary px-4 py-2 text-sm font-medium text-primary cursor-pointer" %>
            <% end %>
          </details>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
