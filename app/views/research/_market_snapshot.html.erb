<%# locals: (security:, scan:) %>
<%# Market facts for a ticker nobody in this family holds. Everything comes from the
    cached research scan; a figure the scan did not supply reads "Unavailable", never 0. %>
<% scan = scan.to_h %>
<% snapshot = security.research_snapshot %>
<% price = scan["regularMarketPrice"] %>
<% change = scan["changePct"] %>
<% pct = ->(value) { value.nil? ? "Unavailable" : "#{value.to_f.positive? ? "+" : ""}#{number_to_percentage(value, precision: 1)}" } %>
<% tone = ->(value) { value.nil? ? "text-primary" : value.to_f.positive? ? "text-success" : value.to_f.negative? ? "text-destructive" : "text-primary" } %>
<% low = scan["fiftyTwoWeekLow"]&.to_d %>
<% high = scan["fiftyTwoWeekHigh"]&.to_d %>
<% position = price && low && high && high > low ? [[((price.to_d - low) / (high - low) * 100).to_f, 0].max, 100].min : nil %>
<% mas = { "20-day" => scan["ma20"], "50-day" => scan["ma50"], "200-day" => scan["ma200"] } %>

<section class="mb-6 rounded-xl border border-tertiary bg-container overflow-hidden" data-testid="market-snapshot">
  <div class="flex flex-wrap items-start justify-between gap-2 border-b border-tertiary px-4 py-3">
    <div>
      <h2 class="font-medium text-primary">Market snapshot</h2>
      <p class="mt-1 text-xs text-secondary">Not held in your accounts, so there are no positions, cost basis or tax lots to show. Reference data only.</p>
    </div>
    <% if snapshot&.generated_at %><p class="text-xs <%= snapshot.stale? ? "text-warning" : "text-secondary" %>"><%= snapshot.stale? ? "Stale" : "As of" %> <%= l(snapshot.generated_at, format: :long) %></p><% end %>
  </div>

  <% if scan.blank? %>
    <p class="p-4 text-sm text-secondary" data-testid="market-snapshot-unavailable">Price and trend data are unavailable for this ticker. Stock data and research below may still be available.</p>
  <% else %>
    <div class="grid grid-cols-2 gap-px bg-tertiary @2xl:grid-cols-4">
      <div class="bg-container p-4"><p class="text-xs text-secondary">Last price</p><p class="mt-1 text-lg font-medium text-primary"><%= price ? format_money(Money.new(price, "USD")) : "Unavailable" %></p></div>
      <div class="bg-container p-4"><p class="text-xs text-secondary">Day change</p><p class="mt-1 text-lg font-medium <%= tone.call(change) %>"><%= pct.call(change) %></p></div>
      <div class="bg-container p-4"><p class="text-xs text-secondary">20-day return</p><p class="mt-1 text-lg font-medium <%= tone.call(scan["return20dPct"]) %>"><%= pct.call(scan["return20dPct"]) %></p></div>
      <div class="bg-container p-4"><p class="text-xs text-secondary">63-day return</p><p class="mt-1 text-lg font-medium <%= tone.call(scan["return63dPct"]) %>"><%= pct.call(scan["return63dPct"]) %></p></div>
    </div>

    <% if position %>
      <div class="border-t border-tertiary p-4">
        <div class="mb-2 flex justify-between text-xs text-secondary"><span>52-week low <%= format_money(Money.new(low, "USD")) %></span><span>52-week high <%= format_money(Money.new(high, "USD")) %></span></div>
        <div class="relative h-3 rounded-full bg-tertiary"><span class="absolute top-1/2 h-5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-container bg-primary" style="left: <%= position %>%" title="Last price"></span></div>
      </div>
    <% end %>

    <dl class="grid gap-x-6 gap-y-2 border-t border-tertiary p-4 text-sm @xl:grid-cols-2">
      <% mas.each do |label, average| %>
        <div class="flex items-center justify-between gap-3"><dt class="text-secondary">vs <%= label %> average</dt><dd class="text-primary"><%= average && price ? pct.call((price.to_d / average.to_d - 1) * 100) : "Unavailable" %></dd></div>
      <% end %>
      <div class="flex items-center justify-between gap-3"><dt class="text-secondary">20-day vs QQQ</dt><dd class="<%= tone.call(scan["relativeStrength20dVsQQQ"]) %>"><%= pct.call(scan["relativeStrength20dVsQQQ"]) %></dd></div>
      <div class="flex items-center justify-between gap-3"><dt class="text-secondary">63-day vs SPY</dt><dd class="<%= tone.call(scan["relativeStrength63dVsSPY"]) %>"><%= pct.call(scan["relativeStrength63dVsSPY"]) %></dd></div>
      <% if scan["sector"].present? %><div class="flex items-center justify-between gap-3"><dt class="text-secondary">Sector</dt><dd class="min-w-0 truncate text-primary"><%= scan["sector"] %></dd></div><% end %>
      <% if Array(scan["sourceIndexes"]).any? %><div class="flex items-center justify-between gap-3"><dt class="text-secondary">Index</dt><dd class="min-w-0 truncate text-primary"><%= Array(scan["sourceIndexes"]).map { |i| { "sp500" => "S&P 500", "sp400" => "S&P 400", "nasdaq100" => "Nasdaq-100" }.fetch(i, i) }.join(", ") %></dd></div><% end %>
    </dl>
  <% end %>
</section>
