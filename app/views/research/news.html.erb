<% content_for :page_title, t(".title") %>

<%= turbo_frame_tag "investment_workspace", target: "_top" do %>
  <div class="mb-6 space-y-1">
    <%= render "investments/workspace_header", current: :news, title: t(".title"), subtitle: t(".subtitle") %>
  </div>

  <div class="@container mb-5">
    <%= form_with url: research_news_path, method: :get, class: "rounded-xl border border-tertiary bg-container p-4 grid gap-3 @md:grid-cols-2 @3xl:grid-cols-3" do |f| %>
      <div class="@md:col-span-2 @3xl:col-span-3"><%= f.search_field :q, value: @query, placeholder: t(".search_placeholder"), class: "form-field__input", aria: { label: t(".search_label") } %></div>
      <%= f.select :scope, %w[overall portfolio account security watchlist all].map { |scope| [t("pages.dashboard.settings.options.scope.#{scope}"), scope] }, { selected: @scope }, class: "form-field__input", aria: { label: t(".scope_label") } %>
      <% if @account_id.present? %><%= f.hidden_field :account_id, value: @account_id %><% end %>
      <%= f.select :source, [[t(".all_sources"), ""]] + @sources.map { |source| [source, source] }, { selected: @source }, class: "form-field__input", aria: { label: t(".source_label") } %>
      <%= f.select :category, [[t(".all_topics"), ""]] + @categories.map { |category| [category.to_s.humanize, category] }, { selected: @category }, class: "form-field__input", aria: { label: t(".topic_label") } %>
      <%= f.select :sentiment, [[t(".all_sentiments"), ""]] + Security::HeadlineToneAnalyzer::TONES.map { |tone| [t("pages.dashboard.settings.options.sentiment.#{tone}"), tone] }, { selected: @sentiment }, class: "form-field__input", aria: { label: t(".sentiment_label") } %>
      <%= f.text_field :ticker, value: @ticker, placeholder: t(".ticker_placeholder"), class: "form-field__input", aria: { label: t(".ticker_label") } %>
      <%= f.select :sort, [[t(".sort_latest"), "latest"], [t(".sort_oldest"), "oldest"], [t(".sort_title"), "title"]], { selected: @sort }, class: "form-field__input", aria: { label: t(".sort_label") } %>
      <%= f.select :period, %w[all 1m 3m ytd 1y].map { |period| [t("pages.dashboard.settings.options.period.#{period}"), period] }, { selected: @period }, class: "form-field__input", aria: { label: t(".period_label") } %>
      <%= f.select :filter, %w[all sentiment].map { |filter| [t("pages.dashboard.settings.options.filter.#{filter}"), filter] }, { selected: @filter }, class: "form-field__input", aria: { label: t(".filter_label") } %>
      <%= f.select :density, %w[compact detail].map { |density| [t("pages.dashboard.settings.options.density.#{density}"), density] }, { selected: @density }, class: "form-field__input", aria: { label: t(".density_label") } %>
      <%= f.submit t(".apply"), class: "px-4 py-2 rounded-lg text-sm font-medium button-bg-primary text-inverse" %>
    <% end %>
  </div>

  <p class="mb-3 text-sm text-secondary"><%= t(".results", count: @total, page: @page) %></p>
  <section class="space-y-3 pb-6 lg:pb-12" aria-label="<%= t(".articles_label") %>">
    <% @articles.each do |article| %>
      <article class="rounded-xl border border-tertiary bg-container p-4">
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span class="rounded-full bg-surface-inset px-2 py-1 text-secondary"><%= article[:source] %></span>
          <% if article[:category].present? %><span class="rounded-full bg-surface-inset px-2 py-1 text-secondary"><%= article[:category].humanize %></span><% end %>
          <% article[:tickers].each do |ticker| %><%= link_to ticker, research_ticker_path(ticker), class: "rounded-full bg-info-surface px-2 py-1 text-info hover:underline" %><% end %>
          <%= render "holdings/headline_sentiments", sentiments: article[:headline_sentiments] %>
          <span class="text-secondary"><%= article[:published_at].present? ? l(article[:published_at], format: :short) : t(".publication_time_unavailable") %></span>
        </div>
        <%= link_to article[:url], target: "_blank", rel: "noopener noreferrer", class: "block mt-3 text-base font-medium text-link leading-snug focus-ring" do %><%= article[:title] %><% end %>
        <% if @density == "detail" && article[:description].present? %><p class="mt-2 text-sm text-secondary leading-relaxed"><%= truncate(article[:description], length: 260) %></p><% end %>
      </article>
    <% end %>
    <% if @articles.empty? %><p class="rounded-xl border border-tertiary p-5 text-sm text-secondary"><%= t(".empty") %></p><% end %>
    <% if @total > @page * ResearchController::PAGE_SIZE %><%= link_to t(".load_more"), research_news_path(request.query_parameters.merge(page: @page + 1)), class: "inline-block mt-2 text-sm font-medium text-link" %><% end %>
  </section>
<% end %>
