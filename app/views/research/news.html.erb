<% content_for :page_header do %><div class="mb-6"><h1 class="text-xl lg:text-3xl font-medium text-primary">News</h1><p class="text-sm text-secondary mt-1">Cached articles tagged to securities you hold. Reference context only; article timestamps and sources are preserved.</p></div><% end %>
<section class="space-y-3"><% @articles.each do |article| %><%= link_to article[:url], target: "_blank", rel: "noopener", class: "block rounded-xl border border-tertiary p-4 hover:bg-surface-hover" do %><p class="text-base font-medium text-primary"><%= article[:title] %></p><p class="mt-1 text-sm text-secondary"><%= [article[:source], article[:published_at], article[:tickers].join(", ")].compact_blank.join(" · ") %></p><% end %><% end %><% if @articles.empty? %><p class="text-secondary">No matching cached news is currently available.</p><% end %></section>
