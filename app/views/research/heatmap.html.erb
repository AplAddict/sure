<% content_for :page_header do %><div class="mb-6"><h1 class="text-xl lg:text-3xl font-medium text-primary">Market heatmap</h1><p class="text-sm text-secondary mt-1">Cached Finviz-style scan. As of <%= @heatmap && @heatmap["lastScan"] || "unavailable" %>; reference only, not live pricing or a trade signal.</p></div><% end %>
<% if @heatmap.present? %><div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-5 gap-2"><% Array(@heatmap["tickers"]).each do |row| %><% change = row["changePct"].to_f %><div class="rounded-xl p-4 border <%= change.positive? ? "border-success bg-success-surface" : change.negative? ? "border-destructive bg-destructive-surface" : "border-tertiary bg-container" %>"><div class="flex justify-between gap-2"><p class="font-medium text-primary"><%= row["ticker"] %></p><p class="text-sm <%= change.positive? ? "text-success" : change.negative? ? "text-destructive" : "text-secondary" %>"><%= number_to_percentage(change, precision: 2) %></p></div><p class="mt-2 text-sm text-primary"><%= row["price"] ? number_to_currency(row["price"]) : "Unavailable" %></p><p class="mt-1 text-xs text-secondary">52w: <%= row["distFromHigh"] %>% from high</p></div><% end %></div><% else %><p class="text-secondary">Heatmap reference artifact is unavailable. No live fallback is used.</p><% end %>
