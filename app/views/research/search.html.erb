<% content_for :page_header do %>
  <div class="space-y-3 mb-6">
    <h1 class="text-xl lg:text-3xl font-medium text-primary">Research search</h1>
    <%= form_with url: research_search_path, method: :get, class: "flex gap-2 max-w-2xl" do |f| %>
      <%= f.search_field :q, value: @query, placeholder: "Any ticker (AAPL, $XYZ), company or news", class: "form-field__input grow", aria: { label: "Search research" } %>
      <%= f.submit "Search", class: "px-4 py-2 rounded-lg text-sm font-medium button-bg-primary text-inverse" %>
    <% end %>
  </div>
<% end %>
<div class="@container">
<div class="grid gap-6 @3xl:grid-cols-2">
  <section class="min-w-0 rounded-xl border border-tertiary p-4"><h2 class="text-base font-medium text-primary mb-3">Your holdings</h2><div class="space-y-2"><% @securities.each do |security| %><div class="flex items-baseline justify-between gap-3 text-sm"><%= link_to security.ticker, research_ticker_path(security.ticker), class: "text-link font-medium" %><span class="min-w-0 truncate text-secondary"><%= security.name.presence || "Name unavailable" %></span></div><% end %><% if @securities.empty? %><p class="text-sm text-secondary"><%= @query.present? ? "None of your holdings match." : "Nothing held yet." %></p><% end %></div>
    <% if @query.blank? %><p class="mt-4 border-t border-tertiary pt-3 text-xs text-secondary">Search a ticker or company name to open research for any stock, held or not.</p><% end %>
    <% if @other_securities.any? || @lookup_ticker %>
      <h2 class="mt-5 mb-3 border-t border-tertiary pt-4 text-base font-medium text-primary">Other tickers</h2>
      <div class="space-y-2" data-testid="other-tickers">
        <% @other_securities.each do |security| %><div class="flex items-baseline justify-between gap-3 text-sm"><%= link_to security.ticker, research_ticker_path(security.ticker), class: "text-link font-medium" %><span class="min-w-0 truncate text-secondary"><%= security.name.presence || "Name unavailable" %></span></div><% end %>
        <% if @lookup_ticker %><div class="flex items-baseline justify-between gap-3 text-sm" data-testid="lookup-ticker"><%= link_to "Open #{@lookup_ticker}", research_ticker_path(@lookup_ticker), class: "text-link font-medium" %><span class="text-secondary">Not in our list yet. We will look it up.</span></div><% end %>
      </div>
    <% end %>
  </section>
  <section class="min-w-0 rounded-xl border border-tertiary p-4"><h2 class="text-base font-medium text-primary mb-3">Cached news</h2><div class="space-y-3"><% @articles.each do |article| %><%= link_to article[:url], target: "_blank", rel: "noopener", class: "block" do %><p class="text-sm font-medium text-link"><%= article[:title] %></p><p class="text-xs text-secondary"><%= [article[:source], article[:published_at], article[:tickers].join(", ")].compact_blank.join(" · ") %></p><div class="mt-1 flex flex-wrap gap-1 text-xs"><%= render "holdings/headline_sentiments", sentiments: article[:headline_sentiments] %></div><% end %><% end %><% if @articles.empty? %><p class="text-sm text-secondary">No cached articles match.</p><% end %></div></section>
</div>
</div>
