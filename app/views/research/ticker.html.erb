<% content_for :page_header do %>
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="text-xs font-medium uppercase tracking-wide text-secondary">Unified ticker workspace</p>
      <h1 class="mt-1 text-xl lg:text-3xl font-medium text-primary"><%= @ticker %></h1>
      <p class="text-sm text-secondary mt-1"><%= @security.name.presence || "Ticker workspace" %> · all accessible Sure holdings</p>
    </div>
    <%= link_to "Search", research_search_path, class: "text-sm font-medium text-link hover:underline" %>
  </div>
<% end %>

<% if @aggregate_position[:available] %>
  <% currency = @aggregate_position[:currency] %>
  <% gain = @aggregate_position[:gain_loss] %>
  <% gain_pct = @aggregate_position[:book_value].positive? ? gain / @aggregate_position[:book_value] * 100 : nil if gain %>
  <section class="mb-6 grid grid-cols-2 lg:grid-cols-5 gap-px overflow-hidden rounded-xl border border-tertiary bg-tertiary">
    <div class="bg-container p-4"><p class="text-xs text-secondary">Accounts</p><p class="mt-1 text-lg font-medium text-primary"><%= @aggregate_position[:account_count] %></p></div>
    <div class="bg-container p-4"><p class="text-xs text-secondary">Total quantity</p><p class="mt-1 text-lg font-medium text-primary"><%= format_quantity(@aggregate_position[:quantity], exact: true) %></p></div>
    <div class="bg-container p-4"><p class="text-xs text-secondary">Market value</p><p class="mt-1 text-lg font-medium text-primary privacy-sensitive"><%= format_money(Money.new(@aggregate_position[:market_value], currency)) %></p></div>
    <div class="bg-container p-4"><p class="text-xs text-secondary">Known cost basis</p><p class="mt-1 text-lg font-medium text-primary privacy-sensitive"><%= @aggregate_position[:book_value] ? format_money(Money.new(@aggregate_position[:book_value], currency)) : "Unavailable" %></p></div>
    <div class="bg-container p-4"><p class="text-xs text-secondary">Unrealized gain / loss</p><p class="mt-1 text-lg font-medium privacy-sensitive <%= gain&.positive? ? "text-success" : gain&.negative? ? "text-destructive" : "text-primary" %>"><%= gain ? "#{format_money(Money.new(gain, currency))}#{gain_pct ? " (#{number_to_percentage(gain_pct, precision: 1)})" : ""}" : "Unavailable" %></p></div>
  </section>
  <% unless @aggregate_position[:book_value] %><p class="-mt-3 mb-6 text-xs text-secondary">Cost basis is available for <%= @aggregate_position[:covered_accounts] %> of <%= @aggregate_position[:account_count] %> accounts. Sure does not infer missing basis.</p><% end %>
<% else %>
  <p class="mb-6 text-xs text-secondary">This symbol is held in more than one currency, so aggregate money totals are intentionally unavailable. Account-level values remain below.</p>
<% end %>

<%= render "holdings/tradingview_chart", security: @security %>

<div class="mt-6 grid gap-6 xl:grid-cols-2">
  <section class="rounded-xl border border-tertiary bg-container overflow-hidden">
    <div class="px-4 py-3 border-b border-tertiary"><h2 class="font-medium text-primary">Positions & cost basis</h2><p class="mt-1 text-xs text-secondary">Broker/Sure position truth by account. Account links return to the existing Holdings tab.</p></div>
    <div class="divide-y divide-tertiary">
      <% @holdings.each do |holding| %>
        <% basis_total = holding.cost_basis.present? && holding.qty.positive? ? holding.cost_basis * holding.qty : nil %>
        <% position_gain = basis_total ? holding.amount - basis_total : nil %>
        <div class="p-4">
          <div class="flex flex-wrap items-start justify-between gap-3"><div><%= link_to holding.account.name, account_path(holding.account, tab: "holdings"), class: "font-medium text-link hover:underline" %><p class="mt-1 text-xs text-secondary"><%= format_quantity(holding.qty, exact: true) %> shares · <%= holding.cost_basis ? "#{format_money(Money.new(holding.cost_basis, holding.currency))}/share" : "cost unavailable" %></p></div><div class="text-right"><p class="privacy-sensitive text-sm font-medium text-primary"><%= format_money(holding.amount_money) %></p><p class="mt-1 text-xs privacy-sensitive <%= position_gain&.positive? ? "text-success" : position_gain&.negative? ? "text-destructive" : "text-secondary" %>"><%= position_gain ? "#{format_money(Money.new(position_gain, holding.currency))} unrealized" : "gain unavailable" %></p></div></div>
          <div class="mt-3 flex items-center justify-between text-xs"><span class="text-secondary">Cost-basis source: <%= holding.cost_basis_source_label || "Unavailable" %></span><%= link_to "Open account holding", holding_path(holding), data: { turbo_frame: :drawer }, class: "font-medium text-link hover:underline" %></div>
        </div>
      <% end %>
    </div>
  </section>

  <section class="rounded-xl border border-tertiary bg-container overflow-hidden">
    <div class="px-4 py-3 border-b border-tertiary"><h2 class="font-medium text-primary">Verified purchase history</h2><p class="mt-1 text-xs text-secondary">Actual retained acquisition entries—not synthetic tax lots or average-cost reconstruction.</p></div>
    <% if @purchase_entries.any? %><div class="divide-y divide-tertiary"><% @purchase_entries.first(25).each do |entry| %><% trade = entry.trade %><div class="p-4 flex flex-wrap justify-between gap-3 text-sm"><div><p class="font-medium text-primary"><%= l(entry.date, format: :long) %> · <%= entry.account.name %></p><p class="mt-1 text-secondary"><%= format_quantity(trade.qty, exact: true) %> shares at <%= trade.price_money.format %><%= " · fee #{trade.fee_money.format}" if trade.fee.present? && trade.fee.positive? %></p></div><%= link_to "Open holding", holding_path(entry.account.current_holdings.find_by(security_id: trade.security_id)), data: { turbo_frame: :drawer }, class: "self-center text-sm font-medium text-link hover:underline" if entry.account.current_holdings.exists?(security_id: trade.security_id) %></div><% end %></div><% else %><p class="p-4 text-sm text-secondary">No preserved purchase entries are available for this ticker.</p><% end %>
  </section>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-2">
  <section class="rounded-xl border border-tertiary bg-container overflow-hidden"><div class="px-4 py-3 border-b border-tertiary"><h2 class="font-medium text-primary">Fundamentals & stock data</h2></div><%= render "holdings/stock_data", security: @security %></section>
  <section class="rounded-xl border border-tertiary bg-container overflow-hidden"><div class="px-4 py-3 border-b border-tertiary"><h2 class="font-medium text-primary">Ticker research</h2></div><%= render "holdings/ticker_research", security: @security %></section>
  <section class="rounded-xl border border-tertiary bg-container overflow-hidden"><div class="px-4 py-3 border-b border-tertiary"><h2 class="font-medium text-primary">News</h2></div><%= render "holdings/ticker_news", security: @security %></section>
  <section class="rounded-xl border border-tertiary bg-container overflow-hidden"><div class="px-4 py-3 border-b border-tertiary"><h2 class="font-medium text-primary">Research notes</h2></div><%= render "holdings/ticker_research_notes", security: @security %></section>
</div>
