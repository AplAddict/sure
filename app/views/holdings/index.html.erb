<%= turbo_frame_tag dom_id(@account, "holdings") do %>
  <div class="bg-container space-y-4 px-3 py-4 lg:p-4 rounded-xl shadow-border-xs">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <%= tag.h2 t(".holdings"), class: "font-medium text-lg" %>
      <nav class="flex items-center gap-2" aria-label="<%= t(".views.label") %>">
        <% HoldingsController::HOLDING_VIEWS.each do |view| %>
          <%= link_to t(".views.#{view}"), holdings_path(account_id: @account.id, view: view, metric: @display_metric),
                class: "rounded-lg px-2 py-1 text-xs font-medium focus-ring #{@holdings_view == view ? "button-bg-secondary text-primary" : "text-secondary hover:bg-surface-hover"}",
                aria: { current: (@holdings_view == view ? "page" : nil) },
                data: { turbo_frame: dom_id(@account, :holdings) } %>
        <% end %>
      </nav>
      <%= link_to new_trade_path(account_id: @account.id),
                  id: dom_id(@account, "new_trade"),
                  data: { turbo_frame: :modal },
                  class: "flex gap-1 font-medium items-center button-bg-secondary hover:button-bg-secondary-hover text-primary p-2 rounded-lg" do %>
        <span class="text-primary">
          <%= icon("plus", color: "current") %>
        </span>
        <%= tag.span t(".new_holding"), class: "text-sm" %>
      <% end %>
    </div>

    <% if @holdings_view == "compact" %>
      <%= form_with url: holdings_path, method: :get, class: "flex items-center justify-end gap-2", data: { controller: "auto-submit-form", turbo_frame: dom_id(@account, :holdings) } do |f| %>
        <%= f.hidden_field :account_id, value: @account.id %><%= f.hidden_field :view, value: @holdings_view %>
        <%= f.label :metric, t(".metric_label"), class: "text-xs text-secondary" %>
        <%= f.select :metric, options_for_select(HoldingsController::DISPLAY_METRICS.map { |metric| [ t(".metrics.#{metric}"), metric ] }, @display_metric), {}, class: "form-field__input text-sm", data: { auto_submit_form_target: "auto" } %>
      <% end %>
    <% end %>

    <% if @trade_republic_categories.present? %>
      <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
        <% @trade_republic_categories.each do |category, summary| %>
          <div class="rounded-lg border border-secondary bg-container-inset px-3 py-2">
            <p class="text-xs text-secondary"><%= t("trade_republic_items.portfolio_categories.#{category}") %></p>
            <p class="text-sm font-medium text-primary"><%= t(".positions", count: summary[:count]) %></p>
            <p class="text-xs text-secondary"><%= format_money Money.new(summary[:value].round(2), @account.currency) %></p>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @current_holdings.empty? && @account.cash_balance.to_d <= 0 %>
      <%= render DS::EmptyState.new(icon: "briefcase", title: t(".no_holdings"), description: t(".no_holdings_description"), data: { testid: "holdings-empty" }) do |empty| %>
        <% empty.with_action do %>
          <%= render DS::Link.new(text: t(".new_holding"), href: new_trade_path(account_id: @account.id), variant: "outline", size: "sm", icon: "plus", frame: :modal) %>
        <% end %>
      <% end %>
    <% elsif @holdings_view == "advanced" %>
      <%= render "holdings/advanced_table", account: @account, portfolio: @advanced_portfolio %>
    <% else %>
    <div class="bg-container-inset rounded-xl p-1 overflow-x-auto">
      <div class="w-max lg:w-full">
        <div class="grid grid-cols-12 items-center uppercase text-xs font-medium text-secondary px-4 py-2">
          <%= tag.p t(".name"), class: "col-span-4" %>
          <%= tag.p t(".weight"), class: "col-span-2 justify-self-end" %>
          <%= tag.p t(".average_cost"), class: "col-span-2 justify-self-end" %>
          <%= tag.p t(".holdings"), class: "col-span-2 justify-self-end" %>
          <%= tag.p t(".return"), class: "col-span-2 justify-self-end" %>
        </div>

        <div class="bg-container rounded-lg shadow-border-xs">
          <% if @account.cash_balance.to_d > 0 %>
            <%= render "holdings/cash", account: @account %>
            <%= render "shared/ruler" %>
          <% end %>

          <% if @current_holdings.any? %>
            <% @current_holdings.each_with_index do |holding, index| %>
              <%= render "holdings/holding", holding: holding, crypto: @account.crypto?, metric: @display_metric %>
              <%= render "shared/ruler" unless index == @current_holdings.length - 1 %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
    <% end %>
  </div>
<% end %>
