<% block = portfolio.blocks.first %>
<% unavailable = "Unavailable" %>
<% qty = ->(value) { value.zero? ? "0" : number_with_precision(value, precision: 8, strip_insignificant_zeros: true) } %>
<% money = ->(amount, currency) { amount.nil? ? tag.span("—", class: "text-secondary", title: unavailable) : tag.span(format_money(Money.new(amount, currency)), class: "privacy-sensitive") } %>
<% gain = ->(amount, currency) { amount.nil? ? tag.span("—", class: "text-secondary", title: unavailable) : tag.span(format_money(Money.new(amount, currency)), class: "privacy-sensitive #{amount.positive? ? "text-success" : amount.negative? ? "text-destructive" : "text-primary"}") } %>
<% percent = ->(amount) { amount.nil? ? tag.span("—", class: "text-secondary", title: unavailable) : tag.span(number_to_percentage(amount, precision: 1), class: amount.positive? ? "text-success" : amount.negative? ? "text-destructive" : "text-primary") } %>
<% sort_th = lambda do |label, key, align: :right, css: "px-3 py-2.5 font-medium"|
     sortable_header(label, key, sort: portfolio.sort, direction: portfolio.direction, align: align, css: css,
                     link_data: { turbo_frame: dom_id(account, :holdings) }) do |sort_key, dir|
       holdings_path(account_id: account.id, view: "advanced", sort: sort_key, dir: dir)
     end
   end %>
<div class="overflow-x-auto rounded-xl border border-tertiary" data-testid="account-holdings-advanced">
  <table class="min-w-[1120px] w-full text-sm">
    <caption class="sr-only"><%= t("holdings.advanced_table.caption", account: account.name) %></caption>
    <thead class="bg-container-inset text-xs uppercase text-secondary">
      <tr>
        <%= sort_th.call(t("holdings.advanced_table.columns.security"), "symbol", align: :left, css: "px-4 py-2.5 font-medium") %>
        <%= sort_th.call(t("holdings.advanced_table.columns.quantity"), "quantity") %>
        <%= sort_th.call(t("holdings.advanced_table.columns.share_price"), "price") %>
        <%= sort_th.call(t("holdings.advanced_table.columns.cost_per_share"), "avg_cost") %>
        <%= sort_th.call(t("holdings.advanced_table.columns.total_value"), "market_value") %>
        <th scope="col" class="px-3 py-2.5 text-right font-medium"><%= t("holdings.advanced_table.columns.day_gain") %></th>
        <%= sort_th.call(t("holdings.advanced_table.columns.total_gain"), "gain") %>
        <th scope="col" class="px-3 py-2.5 text-right font-medium"><%= t("holdings.advanced_table.columns.day_gain_pct") %></th>
        <%= sort_th.call(t("holdings.advanced_table.columns.total_gain_pct"), "gain_pct") %>
        <%= sort_th.call(t("holdings.advanced_table.columns.weight"), "weight", css: "px-4 py-2.5 font-medium") %>
      </tr>
    </thead>
    <tbody class="divide-y divide-tertiary">
      <% if block %>
        <% block.positions.each do |position| %>
          <tr class="hover:bg-container-inset/60">
            <th scope="row" class="px-4 py-3 text-left font-normal"><div class="flex items-center gap-2"><% if (logo = position.security.display_logo_url).present? %><%= image_tag logo, alt: position.ticker, class: "h-6 w-6 shrink-0 rounded-full", loading: "lazy", data: { testid: "holding-logo" } %><% end %><span><%= link_to position.ticker, research_ticker_path(position.ticker), class: "font-semibold text-link hover:underline", data: { turbo_frame: "_top" } %><span class="block max-w-[15rem] truncate text-xs text-secondary"><%= position.name %></span></span></div></th>
            <td class="px-3 py-3 text-right font-mono"><%= qty.call(position.quantity) %></td>
            <td class="px-3 py-3 text-right font-mono"><%= money.call(position.price, position.currency) %></td>
            <td class="px-3 py-3 text-right font-mono"><%= money.call(position.avg_cost, position.currency) %></td>
            <td class="px-3 py-3 text-right font-mono font-medium"><%= money.call(position.market_value, position.currency) %></td>
            <td class="px-3 py-3 text-right font-mono"><%= gain.call(position.day_gain, position.currency) %></td>
            <td class="px-3 py-3 text-right font-mono"><%= gain.call(position.gain, position.currency) %></td>
            <td class="px-3 py-3 text-right font-mono"><%= percent.call(position.day_gain_pct) %></td>
            <td class="px-3 py-3 text-right font-mono"><%= percent.call(position.gain_pct) %></td>
            <td class="px-4 py-3 text-right font-mono"><%= position.weight ? number_to_percentage(position.weight, precision: 1) : "—" %></td>
          </tr>
          <% if position.lots? %>
            <tr class="bg-container-inset">
              <td colspan="10" class="px-4 py-2">
                <details>
                  <summary class="cursor-pointer text-xs font-medium text-link"><%= pluralize(position.lots.size, "broker tax lot") %></summary>
                  <div class="mt-2 min-w-[680px] text-xs">
                    <div class="grid grid-cols-6 gap-2 px-1 pb-1 font-medium uppercase tracking-wide text-secondary">
                      <span>Acquired</span><span class="text-right">Shares</span><span class="text-right">Basis</span><span class="text-right">Value</span><span class="text-right">Gain / loss</span><span class="text-right">Gain / loss %</span>
                    </div>
                    <% position.lots.each do |lot| %>
                      <div class="grid grid-cols-6 gap-2 border-t border-tertiary px-1 py-1.5 text-secondary">
                        <span><%= lot.acquired_on ? l(lot.acquired_on, format: :long) : "Date unavailable" %></span>
                        <span class="text-right"><%= qty.call(lot.quantity) %></span>
                        <span class="text-right"><%= money.call(lot.cost_basis, position.currency) %></span>
                        <span class="text-right"><%= money.call(lot.market_value, position.currency) %></span>
                        <span class="text-right"><%= gain.call(lot.gain, position.currency) %></span>
                        <span class="text-right"><%= percent.call(lot.gain_pct) %></span>
                      </div>
                    <% end %>
                  </div>
                </details>
              </td>
            </tr>
          <% end %>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
