<%# locals: (holding:, crypto:, metric: "total_gain") %>

<%= turbo_frame_tag dom_id(holding) do %>
  <div class="grid grid-cols-12 items-center text-primary text-sm font-medium p-4">
    <div class="col-span-4 flex items-center gap-4">
      <% if (logo = holding.security.display_logo_url).present? %>
        <%= image_tag logo, class: "w-9 h-9 rounded-full", loading: "lazy" %>
      <% else %>
        <%= render DS::FilledIcon.new(variant: :text, text: holding.name, size: "md", rounded: true) %>
      <% end %>
      <div class="space-y-0.5">
        <%= link_to holding.name, research_ticker_path(holding.ticker), class: "hover:underline" %>

        <% if holding.amount %>
          <%= link_to holding.ticker, research_ticker_path(holding.ticker), class: "text-secondary text-xs uppercase hover:underline" %>
        <% else %>
          <%= render "missing_price_tooltip" %>
        <% end %>
      </div>
    </div>

    <div class="col-span-2 flex justify-end items-center gap-2">
      <% if holding.weight %>
        <%= render "shared/progress_circle", progress: holding.weight %>
        <%= tag.p number_to_percentage(holding.weight, precision: 1) %>
      <% else %>
        <%= tag.p "--", class: "text-secondary mb-5" %>
      <% end %>
    </div>

    <div class="col-span-2 text-right">
      <%= render "holdings/cost_basis_cell", holding: holding, editable: false %>
      <%= tag.p t(".per_share"), class: "font-normal text-secondary" %>
    </div>

    <div class="col-span-2 text-right">
      <% if holding.amount_money %>
        <%= tag.p format_money(holding.amount_money), class: "privacy-sensitive" %>
      <% else %>
        <%= tag.p "--", class: "text-secondary" %>
      <% end %>
      <%= tag.p t(".shares", qty: format_quantity(holding.qty, exact: crypto)), class: "font-normal text-secondary privacy-sensitive" %>
    </div>

    <% metric_trend = metric.start_with?("day_") ? holding.day_change : holding.trend
       metric_value, metric_label, metric_color = case metric
       when "share_price" then [format_money(Money.new(holding.price, holding.currency)), "Share price", nil]
       when "total_value" then [holding.amount_money ? format_money(holding.amount_money) : "—", "Total value", nil]
       when "day_gain", "total_gain" then [metric_trend ? format_money(metric_trend.value) : "—", metric == "day_gain" ? "Day gain" : "Total gain", metric_trend&.color]
       else [metric_trend ? metric_trend.percent_formatted : "—", metric == "day_gain_pct" ? "Day gain %" : "Total gain %", metric_trend&.color]
       end %>
    <div class="col-span-2 text-right" data-testid="holding-metric">
      <%= tag.p metric_value, class: "privacy-sensitive #{metric_color ? "" : "text-primary"}", style: metric_color ? "color: #{metric_color};" : nil %>
      <%= tag.p(metric_value == "—" ? "Unavailable" : metric_label, class: "text-xs text-secondary") %>
    </div>
  </div>
<% end %>
