<%# locals: (security:) %>
<% finviz = security.research_snapshot&.section("finviz") %><% metrics = finviz&.fetch("metrics", {}) || {} %>
<% if finviz.present? %><div class="px-3 py-2 space-y-3" data-testid="finviz-reference"><p class="text-xs text-secondary">Finviz reference snapshot. Click a metric in Ticker research for its explanation.</p><dl class="space-y-2 text-sm"><% [["RSI (14)", metrics["rsi14"]], ["Relative volume", metrics["relativeVolume"]], ["Short float", metrics["shortFloatPct"] && number_to_percentage(metrics["shortFloatPct"], precision: 2)], ["Target price", metrics["targetPrice"] && format_money(Money.new(metrics["targetPrice"], "USD"))], ["52-week high", metrics["high52Week"] && format_money(Money.new(metrics["high52Week"], "USD"))], ["52-week low", metrics["low52Week"] && format_money(Money.new(metrics["low52Week"], "USD"))]].each do |label,value| %><div class="flex justify-between gap-3"><dt class="text-secondary"><%= label %></dt><dd class="text-primary"><%= value.presence || "Unavailable" %></dd></div><% end %></dl></div><% else %><p class="px-3 py-3 text-sm text-secondary">No Finviz reference is available for this security.</p><% end %>
