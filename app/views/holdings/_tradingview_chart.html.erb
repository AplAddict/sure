<%# locals: (security:) %>
<% symbol = security.ticker.to_s.upcase %>
<% chart_symbol = symbol == "SI=F" ? "TVC:SILVER" : symbol %>
<% config = { autosize: true, symbol: chart_symbol, interval: "D", timezone: "America/Chicago", theme: "dark", style: "1", locale: "en", allow_symbol_change: false, hide_top_toolbar: false, hide_legend: false, withdateranges: true, details: true, studies: [], width: "100%", height: "100%" } %>
<div class="px-3 py-2" data-testid="tradingview-chart">
  <div class="rounded-lg overflow-hidden border border-tertiary" style="height: 430px">
    <iframe title="<%= symbol %> TradingView chart" src="https://www.tradingview-widget.com/embed-widget/advanced-chart/?locale=en#<%= ERB::Util.url_encode(config.to_json) %>" class="w-full h-full border-0" sandbox="allow-scripts allow-same-origin allow-forms allow-popups" referrerpolicy="no-referrer" allow="fullscreen" loading="lazy"></iframe>
  </div>
  <p class="pt-2 text-xs text-secondary">Interactive chart by TradingView. Chart data is market reference only and does not change Sure balances or valuations.</p>
</div>
