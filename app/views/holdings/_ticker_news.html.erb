<%# locals: (articles:) %>
<% if articles.present? %>
  <div class="px-3 py-2 space-y-2" data-testid="ticker-news">
    <p class="text-xs text-secondary">Ticker-tagged articles from the imported Invest news cache. Tone badges are Jev’s research-only headline reading, not a trade signal.</p>
    <% articles.first(12).each do |article| %>
      <%= link_to article[:url], target: "_blank", rel: "noopener", class: "block rounded-lg border border-tertiary p-3 hover:button-bg-secondary" do %>
        <div class="flex items-start justify-between gap-2">
          <p class="text-sm font-medium text-primary leading-snug"><%= article[:title] %></p>
          <% if article[:headline_sentiments].present? %>
            <%= render "holdings/headline_sentiments", sentiments: article[:headline_sentiments] %>
          <% end %>
        </div>
        <p class="pt-1 text-xs text-secondary"><%= [article[:source], article[:published_raw]].compact.join(" · ").presence || "Source time unavailable" %></p>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="px-3 py-3 text-sm text-secondary">No current ticker-tagged news is available for this security.</p>
<% end %>
