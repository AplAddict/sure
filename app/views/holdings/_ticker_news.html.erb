<%# locals: (security:) %>
<% news = security.research_snapshot&.section("news") %>
<% if news.present? %><div class="px-3 py-2 space-y-2" data-testid="ticker-news"><p class="text-xs text-secondary">Ticker-tagged articles from the imported Invest news cache.</p><% news.first(12).each do |article| %><% next unless article["title"].present? && article["link"].present? %><%= link_to article["link"], target: "_blank", rel: "noopener", class: "block rounded-lg border border-tertiary p-3 hover:button-bg-secondary" do %><p class="text-sm font-medium text-primary leading-snug"><%= article["title"] %></p><p class="pt-1 text-xs text-secondary"><%= [article["source"], article["published_at"] || article["publishedAt"] || article["time"]].compact.join(" · ").presence || "Source time unavailable" %></p><% end %><% end %></div><% else %><p class="px-3 py-3 text-sm text-secondary">No current ticker-tagged news is available for this security.</p><% end %>
