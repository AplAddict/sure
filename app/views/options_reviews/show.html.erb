<% content_for :page_title, t(".title") %>

<% content_for :page_header do %>
  <div class="mb-6 space-y-1">
    <%= render "investments/subnav", current: :options %>
    <h1 class="text-xl lg:text-3xl font-medium text-primary"><%= t(".title") %></h1>
    <p class="max-w-3xl text-sm text-secondary"><%= t(".subtitle") %></p>
  </div>
<% end %>

<div class="space-y-4 pb-6 lg:pb-12">
  <% if @review.rows.empty? %>
    <%= render DS::EmptyState.new(icon: "chart-no-axes-combined", title: t(".empty_title"), description: t(".empty_description")) %>
  <% else %>
    <div class="overflow-x-auto rounded-xl bg-container shadow-border-xs">
      <table class="w-full min-w-[56rem] text-sm">
        <caption class="sr-only"><%= t(".caption") %></caption>
        <thead class="border-b border-tertiary text-left text-xs uppercase tracking-wide text-secondary">
          <tr>
            <th scope="col" class="px-4 py-3"><%= t(".columns.account") %></th>
            <th scope="col" class="px-4 py-3"><%= t(".columns.contract") %></th>
            <th scope="col" class="px-4 py-3"><%= t(".columns.underlying") %></th>
            <th scope="col" class="px-4 py-3"><%= t(".columns.type") %></th>
            <th scope="col" class="px-4 py-3"><%= t(".columns.expiry") %></th>
            <th scope="col" class="px-4 py-3 text-right"><%= t(".columns.strike") %></th>
            <th scope="col" class="px-4 py-3 text-right"><%= t(".columns.quantity") %></th>
            <th scope="col" class="px-4 py-3 text-right"><%= t(".columns.mark") %></th>
            <th scope="col" class="px-4 py-3 text-right"><%= t(".columns.cost_basis") %></th>
            <th scope="col" class="px-4 py-3 text-right"><%= t(".columns.gain") %></th>
            <th scope="col" class="px-4 py-3"><%= t(".columns.snapshot") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-tertiary">
          <% @review.rows.each do |row| %>
            <% position = row.position %>
            <tr>
              <td class="px-4 py-3 font-medium text-primary"><%= row.account.name %></td>
              <td class="px-4 py-3 font-mono text-primary whitespace-nowrap"><%= position.contract %></td>
              <td class="px-4 py-3"><%= position.underlying || "—" %></td>
              <td class="px-4 py-3"><%= position.type || "—" %></td>
              <td class="px-4 py-3"><%= position.expiration ? "#{l(position.expiration)} · #{t(".dte", count: position.days_to_expiry)}" : "—" %></td>
              <td class="px-4 py-3 text-right font-mono"><%= investment_money(position.strike, position.currency) %></td>
              <td class="px-4 py-3 text-right font-mono"><%= investment_quantity(position.quantity) %></td>
              <td class="px-4 py-3 text-right font-mono"><%= investment_money(position.mark, position.currency) %></td>
              <td class="px-4 py-3 text-right font-mono"><%= investment_money(position.cost_total, position.currency) %></td>
              <td class="px-4 py-3 text-right font-mono"><%= investment_gain(position.gain, position.currency, percent: position.gain_pct, title: t(".gain_unavailable")) %></td>
              <td class="px-4 py-3 text-xs">
                <%= freshness_pill(row.freshness) %>
                <% if row.synced_at %><span class="ml-1 text-secondary"><%= t(".synced_ago", time: time_ago_in_words(row.synced_at)) %></span><% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
