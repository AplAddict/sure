<% content_for :page_title, t(".title") %>

<% desk = @desk %>

<%= turbo_frame_tag "investment_workspace", target: "_top" do %>
  <div class="space-y-4 pb-6 lg:pb-12" data-testid="options-desk">
    <%= render "investments/workspace_header", current: :options, title: t(".title"), subtitle: t(".subtitle"),
          actions: render(DS::Link.new(text: t(".open_legacy"), href: legacy_options_review_path, variant: "default", size: "sm")) %>
    <%= render "options_reviews/desk_alert" %>
    <%= render "options_reviews/desk_source_banner", desk: desk %>
    <% if desk.invalid_account_scope %>
      <div class="rounded-lg border border-tertiary bg-container-inset p-4 text-sm text-primary" data-testid="options-desk-invalid-scope">
        <%= t(".invalid_account") %>
      </div>
    <% else %>
      <%= render "investments/sections",
            sections: InvestmentSections.new(namespace: "options", user: Current.user, definitions: [
              { key: "summary", title: t(".sections.summary"), partial: "options_reviews/desk_summary", locals: { desk: desk } },
              { key: "contracts", title: t(".sections.contracts"), partial: "options_reviews/desk_ledger", locals: { desk: desk, now: @now }, flush: true },
              { key: "ideas", title: t(".sections.ideas"), partial: "options_reviews/desk_ideas", locals: { desk: desk } }
            ]),
            namespace: "options",
            url: investment_section_preferences_path("options"), preference_key: "investments_options" %>
    <% end %>
  </div>
<% end %>
