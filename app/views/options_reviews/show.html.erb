<% content_for :page_title, t(".title") %>

<% review = @review %>

<%= turbo_frame_tag "investment_workspace", target: "_top" do %>
  <div class="mb-6 space-y-1">
    <%= render "investments/workspace_header", current: :options, title: t(".title"), subtitle: t(".subtitle") %>
  </div>
  <div class="space-y-4 pb-6 lg:pb-12">
  <% if review.rows.empty? %>
    <%= render DS::EmptyState.new(icon: "chart-no-axes-combined", title: t(".empty_title"), description: t(".empty_description")) %>
  <% else %>
    <%= render "investments/sections",
          sections: InvestmentSections.new(namespace: "options", user: Current.user, definitions: [
            { key: "summary", title: t(".sections.summary"), partial: "options_reviews/summary", locals: { review: review } },
            { key: "contracts", title: t(".sections.contracts"), partial: "options_reviews/contracts", locals: { review: review } }
          ]),
          namespace: "options",
          url: investment_section_preferences_path("options"), preference_key: "investments_options" %>
  <% end %>
</div>
<% end %>
