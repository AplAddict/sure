<%# locals: (desk:) %>
<% covered = desk.ideas.covered_calls %>
<% puts = desk.ideas.puts %>
<div class="space-y-6">
  <section class="space-y-3" data-testid="options-desk-covered-calls">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h3 class="text-sm font-medium text-primary"><%= t("options_reviews.desk.ideas.covered_calls") %></h3>
      <p class="text-xs text-secondary"><%= t("options_reviews.desk.ideas.research_only") %> · <%= t("options_reviews.desk.ideas.review") %></p>
    </div>
    <p class="text-xs text-secondary"><%= covered.joint_exposure_note %></p>
    <% if covered.ideas.empty? && covered.exclusions.empty? %>
      <p class="text-sm text-secondary"><%= t("options_reviews.desk.ideas.none") %></p>
    <% end %>
    <ul class="space-y-2">
      <% covered.ideas.each do |idea| %>
        <li class="rounded-lg border border-tertiary bg-container-inset p-3 text-sm" data-testid="options-desk-covered-call-idea" data-account-id="<%= idea.account_id %>">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <p class="font-mono text-primary"><%= idea.contract %></p>
            <p class="text-xs text-secondary"><%= idea.account_name %></p>
          </div>
          <p class="mt-1 text-xs text-secondary">
            <span class="privacy-sensitive"><%= t("options_reviews.desk.ideas.meta", underlying: idea.underlying, dte: idea.dte, strike: idea.strike, count: idea.contracts_max) %></span>
          </p>
          <% if idea.flags.any? %>
            <ul class="mt-2 flex flex-wrap gap-1">
              <% idea.flags.each do |flag| %>
                <li><%= render DS::Pill.new(label: options_desk_flag(flag), tone: :warning, marker: false, size: :sm) %></li>
              <% end %>
            </ul>
          <% end %>
        </li>
      <% end %>
      <% covered_groups, covered_hidden = options_desk_exclusion_groups(covered.exclusions) %>
      <% covered_groups.each do |exclusion, count| %>
        <li class="rounded-lg border border-tertiary p-3 text-sm" data-testid="options-desk-covered-call-exclusion" data-account-id="<%= exclusion.account_id %>">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <p class="font-mono text-primary"><%= exclusion.contract %><% if count > 1 %> <span class="text-xs font-sans text-secondary"><%= t("options_reviews.desk.ideas.more_contracts", count: count - 1) %></span><% end %></p>
            <p class="text-xs text-secondary"><%= exclusion.account_name %></p>
          </div>
          <ul class="mt-2 flex flex-wrap gap-1">
            <% exclusion.reasons.each do |reason| %>
              <li><%= render DS::Pill.new(label: options_desk_reason(reason), tone: :neutral, marker: false, size: :sm) %></li>
            <% end %>
          </ul>
        </li>
      <% end %>
      <% covered_hidden.each do |account_name, count| %>
        <li class="text-xs text-secondary" data-testid="options-desk-covered-call-hidden"><%= t("options_reviews.desk.ideas.more_groups_for", account: account_name, count: count) %></li>
      <% end %>
    </ul>
  </section>

  <section class="space-y-3" data-testid="options-desk-puts-unavailable">
    <h3 class="text-sm font-medium text-primary"><%= t("options_reviews.desk.ideas.puts_unavailable") %></h3>
    <p class="text-xs text-secondary"><%= t("options_reviews.desk.ideas.puts_note") %></p>
    <% if puts.exclusions.empty? %>
      <p class="text-sm text-secondary"><%= t("options_reviews.desk.ideas.puts_none") %></p>
    <% else %>
      <ul class="space-y-2">
        <% put_groups, put_hidden = options_desk_exclusion_groups(puts.exclusions) %>
        <% put_groups.each do |exclusion, count| %>
          <li class="rounded-lg border border-tertiary p-3 text-sm" data-account-id="<%= exclusion.account_id %>">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <p class="font-mono text-primary"><%= exclusion.contract %><% if count > 1 %> <span class="text-xs font-sans text-secondary"><%= t("options_reviews.desk.ideas.more_contracts", count: count - 1) %></span><% end %></p>
              <p class="text-xs text-secondary"><%= exclusion.account_name %></p>
            </div>
            <ul class="mt-2 flex flex-wrap gap-1">
              <% exclusion.reasons.each do |reason| %>
                <li><%= render DS::Pill.new(label: options_desk_reason(reason), tone: :neutral, marker: false, size: :sm) %></li>
              <% end %>
            </ul>
          </li>
        <% end %>
        <% put_hidden.each do |account_name, count| %>
          <li class="text-xs text-secondary" data-testid="options-desk-puts-hidden"><%= t("options_reviews.desk.ideas.more_groups_for", account: account_name, count: count) %></li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
