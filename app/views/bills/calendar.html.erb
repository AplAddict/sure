<%= content_for :page_title, "Events" %>

<div class="space-y-4 pb-6 lg:pb-12">
  <%= render "bills/view_switcher", active: "events" %>

  <div class="flex flex-wrap gap-2" aria-label="Filter events">
    <% { "all" => "All", "bills" => "Bills", "paychecks" => "Paychecks", "earnings" => "Earnings", "ex_dividend" => "Dividends", "options_expiration" => "Options", "wash_sale" => "Wash sales" }.each do |key, label| %>
      <%= link_to label, bills_path(view: "events", month: @month.strftime("%Y-%m"), event_filter: key), class: "rounded-full px-3 py-1 text-xs font-medium #{@event_filter == key ? "bg-primary text-inverse" : "bg-container-inset text-secondary hover:text-primary"}" %>
    <% end %>
  </div>

  <div class="grid gap-4 xl:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
    <section class="overflow-hidden rounded-xl bg-container shadow-border-xs">
      <div class="flex items-baseline justify-between gap-3 border-b border-tertiary px-4 py-3">
        <div><h2 class="font-medium text-primary">Next 14 days</h2><p class="mt-0.5 text-xs text-secondary">Bills, paydays, and holdings-derived market deadlines in one action queue.</p></div>
        <span class="shrink-0 text-xs text-secondary"><%= @next_14_days.size %> items</span>
      </div>
      <% if @next_14_days.empty? %>
        <p class="px-4 py-5 text-sm text-secondary">No verified events or scheduled cash-flow items in the next 14 days.</p>
      <% else %>
        <div class="divide-y divide-tertiary">
          <% @next_14_days.each do |item| %>
            <div class="flex items-center gap-3 px-4 py-2.5">
              <div class="w-12 shrink-0 text-center"><p class="text-[11px] uppercase text-secondary"><%= l(item[:date], format: "%b") %></p><p class="text-sm font-semibold text-primary"><%= item[:date].day %></p></div>
              <div class="min-w-0 flex-1"><p class="truncate text-sm font-medium text-primary"><%= item[:title] %></p><p class="truncate text-xs text-secondary"><%= item[:kind] %> · <%= item[:details] %></p></div>
              <% if item[:amount] %><span class="shrink-0 text-sm font-medium text-primary privacy-sensitive"><%= format_money(item[:amount]) %></span><% end %>
              <% if item[:freshness] == "stale" %><span class="shrink-0 text-[11px] text-warning">Stale</span><% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>

    <section class="overflow-hidden rounded-xl bg-container shadow-border-xs">
      <div class="border-b border-tertiary px-4 py-3"><h2 class="font-medium text-primary">Earnings exposure</h2><p class="mt-0.5 text-xs text-secondary">Held equities reporting in the next 14 days. Options are not included in equity value or exposure.</p></div>
      <% if @earnings_exposure.empty? %>
        <p class="px-4 py-5 text-sm text-secondary">No held securities have a verified earnings date in the next 14 days.</p>
      <% else %>
        <div class="divide-y divide-tertiary">
          <% @earnings_exposure.each do |exposure| %>
            <% event = exposure[:event] %>
            <div class="px-4 py-3">
              <div class="flex items-center justify-between gap-3"><%= link_to event.ticker, research_ticker_path(event.ticker), class: "font-semibold text-link hover:underline" %><span class="text-xs text-secondary"><%= l(event.date, format: :long) %></span></div>
              <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-xs text-secondary">
                <span><%= exposure[:account_count] %> <%= "account".pluralize(exposure[:account_count]) %></span>
                <% if exposure[:position_value] && exposure[:currency] %><span class="privacy-sensitive">Position <%= format_money(Money.new(exposure[:position_value], exposure[:currency])) %></span><% else %><span>Position value unavailable across currencies</span><% end %>
                <% if exposure[:weight] %><span><%= number_to_percentage(exposure[:weight], precision: 1) %> of tracked equities</span><% elsif !exposure[:comparable_currency] %><span>Weight unavailable across currencies</span><% end %>
                <% if event.freshness == "stale" %><span class="text-warning">Market data stale</span><% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>
  </div>

  <%# The nav group and a totals line carrying two money values do not share
      375px, and neither had anywhere to wrap. %>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-1 min-w-0">
      <%= render DS::Link.new(
            icon: "chevron-left",
            variant: "ghost",
            href: bills_path(view: "events", month: (@month - 1.month).strftime("%Y-%m")),
            "aria-label": t(".previous_month")
          ) %>
      <% unless @at_forward_limit %>
        <%= render DS::Link.new(
              icon: "chevron-right",
              variant: "ghost",
              href: bills_path(view: "events", month: (@month + 1.month).strftime("%Y-%m")),
              "aria-label": t(".next_month")
            ) %>
      <% end %>
      <h2 class="text-lg font-medium text-primary ml-2 truncate"><%= l(@month, format: "%B %Y") %></h2>
      <% unless @month == Date.current.beginning_of_month %>
        <%= render DS::Link.new(text: t(".today"), variant: "ghost", href: bills_path(view: "events")) %>
      <% end %>
    </div>
    <div class="text-right text-sm">
      <p class="text-secondary">
        <%= t(".month_totals",
              expected: @month_expected ? format_money(@month_expected) : format_money(Money.new(0, Current.family.currency)),
              paid: @month_paid ? format_money(@month_paid) : format_money(Money.new(0, Current.family.currency))) %>
      </p>
      <% if @month_unconvertible.positive? %>
        <p class="text-xs text-warning"><%= t("bills.index.unconvertible", count: @month_unconvertible) %></p>
      <% end %>
    </div>
  </div>

  <%# Month grid: desktop and tablet. %>
  <div class="hidden md:block bg-container rounded-xl shadow-border-xs p-2">
    <div class="grid grid-cols-7 text-xs font-medium text-secondary uppercase">
      <% (0..6).each do |offset| %>
        <div class="px-2 py-1"><%= t("date.abbr_day_names")[offset] %></div>
      <% end %>
    </div>
    <div class="grid grid-cols-7 gap-px bg-alpha-black-100 theme-dark:bg-alpha-white-200 rounded-lg overflow-hidden">
      <% (@grid_start..@grid_end).each do |day| %>
        <% in_month = day.between?(@month, @month.end_of_month) %>
        <div class="bg-container min-h-24 p-1.5 space-y-1 <%= "opacity-40" unless in_month %>">
          <p class="text-xs <%= day == Date.current ? "font-bold text-link" : "text-secondary" %>">
            <%= day.day %>
          </p>
          <% (@by_day[day] || []).sort_by { |occurrence| -occurrence.resolved_expected_amount }.each do |occurrence| %>
            <%= render "bills/calendar_chip", occurrence: occurrence %>
          <% end %>
          <% (@paydays_by_day[day] || []).each do |occurrence| %>
            <%= render "bills/payday_chip", occurrence: occurrence %>
          <% end %>
          <% (@market_events_by_day[day] || []).each do |event| %>
            <%= render "bills/market_event_chip", event: event %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%# Minted for THIS member: the feed applies per-account sharing, so each
        member's URL serves only the bills they can reach in the app. %>
    <%= link_to t(".subscribe_ical"),
          bills_feed_path(token: Current.family.bills_feed_token_for(Current.user)),
          class: "text-xs text-link hover:underline" %>
    <%= button_to t(".reset_feed"),
          reset_feed_token_bills_path,
          class: "text-xs text-secondary hover:underline",
          data: { turbo_confirm: t("bills.reset_feed_token.confirm") } %>
  </div>

  <%# Mobile: an agenda list of the month's days that actually have bills,
      not a shrunken grid. %>
  <div class="md:hidden space-y-1 rounded-xl bg-container-inset p-1">
    <% month_days = ((@by_day.keys + @paydays_by_day.keys + @market_events_by_day.keys).uniq & (@month..@month.end_of_month).to_a).sort %>
    <% if month_days.empty? %>
      <div class="bg-container rounded-lg p-4">
        <p class="text-sm text-secondary"><%= t(".empty_month") %></p>
      </div>
    <% else %>
      <% month_days.each do |day| %>
        <div class="bg-container rounded-lg p-3 space-y-1.5">
          <p class="text-xs font-medium <%= day == Date.current ? "text-link" : "text-secondary" %> uppercase">
            <%= l(day, format: :long) %>
          </p>
          <% (@by_day[day] || []).sort_by { |occurrence| -occurrence.resolved_expected_amount }.each do |occurrence| %>
            <%= render "bills/calendar_chip", occurrence: occurrence %>
          <% end %>
          <% (@paydays_by_day[day] || []).each do |occurrence| %>
            <%= render "bills/payday_chip", occurrence: occurrence %>
          <% end %>
          <% (@market_events_by_day[day] || []).each do |event| %>
            <%= render "bills/market_event_chip", event: event %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
