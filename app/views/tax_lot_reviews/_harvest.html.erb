<%# locals: (harvest:) %>
<%# Tax-loss-harvest detail, embedded in the Tax workspace. %>
<% if harvest.accounts.empty? %>
  <div class="rounded-xl bg-container shadow-border-xs">
    <%= render DS::EmptyState.new(icon: "landmark", title: t("tax_loss_harvests.show.no_accounts.title"), description: t("tax_loss_harvests.show.no_accounts.description")) %>
  </div>
<% else %>
  <%= render "investments/sections",
        sections: InvestmentSections.new(namespace: "tax_harvest", user: Current.user, definitions: [
          { key: "summary", title: t("tax_loss_harvests.show.summary.title"), partial: "tax_lot_reviews/harvest_summary", locals: { harvest: harvest } },
          { key: "candidates", title: t("tax_loss_harvests.show.table.title"), partial: "tax_lot_reviews/harvest_candidates", locals: { rows: harvest.rows } },
          { key: "unavailable", title: t("tax_loss_harvests.show.unavailable.title"), visible: harvest.unavailable.any?,
            partial: "tax_lot_reviews/harvest_unavailable", locals: { unavailable: harvest.unavailable } }
        ]),
        namespace: "tax_harvest",
        url: investment_section_preferences_path("tax_harvest"), preference_key: "investments_tax_harvest" %>
<% end %>
