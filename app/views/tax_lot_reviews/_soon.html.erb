<%# locals: (soon:) %>
<%# Short-term lots about to become long-term. `soon` is
    TaxLotReview#approaching_long_term. %>
<div class="space-y-3">
  <% if soon.empty? %>
    <p class="text-sm text-secondary"><%= t("tax_lot_reviews.show.soon_empty") %></p>
  <% else %>
    <div class="overflow-x-auto rounded-xl bg-container shadow-border-xs">
      <table class="w-full min-w-[40rem] text-sm">
        <caption class="sr-only"><%= t("tax_lot_reviews.show.soon_caption") %></caption>
        <thead class="border-b border-tertiary text-left text-xs uppercase tracking-wide text-secondary">
          <tr>
            <th scope="col" class="px-4 py-3"><%= t("tax_lot_reviews.show.columns.ticker") %></th>
            <th scope="col" class="px-4 py-3"><%= t("tax_lot_reviews.show.columns.account") %></th>
            <th scope="col" class="px-4 py-3"><%= t("tax_lot_reviews.show.columns.acquired") %></th>
            <th scope="col" class="px-4 py-3"><%= t("tax_lot_reviews.show.columns.long_term_in") %></th>
            <th scope="col" class="px-4 py-3 text-right"><%= t("tax_lot_reviews.show.columns.unrealized") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-tertiary">
          <% soon.each do |lot| %>
            <tr>
              <td class="px-4 py-3 font-mono font-medium"><%= link_to lot.ticker, research_ticker_path(lot.ticker), class: "hover:underline" %></td>
              <td class="px-4 py-3"><%= lot.account.name %></td>
              <td class="px-4 py-3"><%= l(lot.acquired_on) %></td>
              <td class="px-4 py-3"><%= t("tax_lot_reviews.show.days", count: lot.days_to_long_term) %></td>
              <td class="px-4 py-3 text-right font-mono"><%= investment_gain(lot.gain, lot.currency) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
