<% content_for :page_title, t(".title") %>

<% content_for :page_header do %>
  <div class="mb-6">
    <%= render "investments/subnav", current: :tax_lots %>
    <div class="space-y-1">
      <h1 class="text-xl lg:text-3xl font-medium text-primary"><%= t(".title") %></h1>
      <p class="max-w-3xl text-sm text-secondary"><%= t(".subtitle") %></p>
    </div>
  </div>
<% end %>

<%= turbo_frame_tag "investment_workspace" do %>
  <div class="space-y-6 pb-6 lg:pb-12">
  <% if turbo_frame_request? %><%= render "investments/workspace_header", current: :tax_lots, title: t(".title"), subtitle: t(".subtitle") %><% end %>
  <nav aria-label="<%= t(".tabs.label") %>" class="flex gap-1 overflow-x-auto border-b border-tertiary" data-testid="tax-workspace-tabs">
    <% [[ "lots", t(".tabs.lots") ], [ "harvest", t(".tabs.harvest") ]].each do |key, label| %>
      <%= link_to label, tax_lot_review_path(tab: key),
            data: { turbo_frame: "investment_workspace", turbo_action: "advance" },
            class: "shrink-0 border-b-2 px-3 py-2 text-sm font-medium focus-ring #{@tab == key ? "border-primary text-primary" : "border-transparent text-secondary hover:text-primary"}",
            aria: { current: (@tab == key ? "page" : nil) } %>
    <% end %>
  </nav>

  <% if @tab == "harvest" %>
    <%= render "harvest", harvest: @harvest %>
  <% else %>
    <% review = @review %>
    <% totals = review.totals %>
    <% currency = review.currency %>
  <% if review.excluded_account_count.positive? %>
    <p class="text-xs text-secondary"><%= t(".excluded", count: review.excluded_account_count) %></p>
  <% end %>
  <% if review.lot_gaps.any? %>
    <details class="rounded-lg bg-container-inset px-4 py-3 text-sm text-secondary" role="status">
      <summary class="cursor-pointer"><%= t(".no_lots", count: review.lot_gaps.size) %> <span class="underline"><%= t(".gaps_show") %></span></summary>
      <% review.lot_gaps.group_by(&:account).each do |account, gaps| %>
        <div class="mt-3">
          <p class="font-medium text-primary"><%= account.name %></p>
          <% gaps.group_by(&:reason).each do |reason, items| %>
            <p class="mt-1"><%= items.map { |gap| gap.security.ticker }.sort.join(", ") %> — <%= t(".gaps_reason.#{reason}") %></p>
          <% end %>
        </div>
      <% end %>
    </details>
  <% end %>
  <% if review.cash_sweeps.any? %>
    <p class="text-xs text-secondary"><%= t(".cash_sweeps", count: review.cash_sweeps.size) %></p>
  <% end %>
  <% if review.unmeasured_count.positive? %>
    <p class="rounded-lg bg-container-inset px-4 py-3 text-sm text-secondary" role="status"><%= t(".unmeasured", count: review.unmeasured_count) %></p>
  <% end %>

  <% if review.lots.empty? %>
    <%= render DS::EmptyState.new(icon: "briefcase", title: t(".empty_title"), description: t(".empty_description")) %>
  <% else %>
    <section aria-labelledby="tl-totals" class="space-y-3">
      <h2 id="tl-totals" class="text-lg font-medium text-primary"><%= t(".totals_heading") %></h2>
      <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        <%= investment_stat t(".short_gains"), investment_money(totals[:short_gain], currency), tone: gain_tone_class(totals[:short_gain]) %>
        <%= investment_stat t(".short_losses"), investment_money(totals[:short_loss], currency), tone: (totals[:short_loss].positive? ? "text-destructive" : "text-primary") %>
        <%= investment_stat t(".long_gains"), investment_money(totals[:long_gain], currency), tone: gain_tone_class(totals[:long_gain]) %>
        <%= investment_stat t(".long_losses"), investment_money(totals[:long_loss], currency), tone: (totals[:long_loss].positive? ? "text-destructive" : "text-primary") %>
      </div>
    </section>

    <section aria-labelledby="tl-soon" class="space-y-3">
      <h2 id="tl-soon" class="text-lg font-medium text-primary"><%= t(".soon_heading", days: review.window_days) %></h2>
      <% soon = review.approaching_long_term %>
      <% if soon.empty? %>
        <p class="text-sm text-secondary"><%= t(".soon_empty") %></p>
      <% else %>
        <div class="overflow-x-auto rounded-xl bg-container shadow-border-xs">
          <table class="w-full min-w-[40rem] text-sm">
            <caption class="sr-only"><%= t(".soon_caption") %></caption>
            <thead class="border-b border-tertiary text-left text-xs uppercase tracking-wide text-secondary">
              <tr>
                <th scope="col" class="px-4 py-3"><%= t(".columns.ticker") %></th>
                <th scope="col" class="px-4 py-3"><%= t(".columns.account") %></th>
                <th scope="col" class="px-4 py-3"><%= t(".columns.acquired") %></th>
                <th scope="col" class="px-4 py-3"><%= t(".columns.long_term_in") %></th>
                <th scope="col" class="px-4 py-3 text-right"><%= t(".columns.unrealized") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-tertiary">
              <% soon.each do |lot| %>
                <tr>
                  <td class="px-4 py-3 font-mono font-medium"><%= link_to lot.ticker, research_ticker_path(lot.ticker), class: "hover:underline" %></td>
                  <td class="px-4 py-3"><%= lot.account.name %></td>
                  <td class="px-4 py-3"><%= l(lot.acquired_on) %></td>
                  <td class="px-4 py-3"><%= t(".days", count: lot.days_to_long_term) %></td>
                  <td class="px-4 py-3 text-right font-mono"><%= investment_gain(lot.gain, lot.currency) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>

    <% sort_link = lambda do |label, key, align: "left"|
         active = review.sort == key
         next_dir = active ? (review.direction == "asc" ? "desc" : "asc") : (%w[ticker account acquired term].include?(key) ? "asc" : "desc")
         arrow = active ? (review.direction == "asc" ? "↑" : "↓") : ""
         link_to(tax_lot_review_path(request.query_parameters.merge("sort" => key, "dir" => next_dir).except("format")),
                 class: "inline-flex items-center gap-1 #{align == "right" ? "justify-end" : ""} hover:text-primary #{active ? "text-primary" : ""}",
                 data: { turbo_frame: "investment_workspace" },
                 aria: { sort: (active ? (review.direction == "asc" ? "ascending" : "descending") : nil) }.compact) do
           safe_join([ label, tag.span(arrow, class: "w-3", "aria-hidden": true) ])
         end
       end %>
    <section aria-labelledby="tl-lots" class="space-y-3">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h2 id="tl-lots" class="text-lg font-medium text-primary"><%= t(".lots_heading") %></h2>
        <%= link_to t(".filter.download"), tax_lot_review_path(request.query_parameters.except("tab", "format", "sort", "dir").merge(format: :csv)), class: "text-sm font-medium text-link hover:underline focus-ring rounded", data: { turbo: false } %>
      </div>
      <%= form_with url: tax_lot_review_path, method: :get, class: "flex flex-wrap items-end gap-3", data: { turbo_frame: "investment_workspace" } do |f| %>
        <%= f.hidden_field :sort, value: review.sort %>
        <%= f.hidden_field :dir, value: review.direction %>
        <div>
          <%= f.label :ticker, t(".filter.ticker"), class: "block text-xs text-secondary" %>
          <%= f.text_field :ticker, value: review.ticker, placeholder: t(".filter.ticker_placeholder"), maxlength: 20, class: "mt-1 w-40 rounded-lg border border-tertiary bg-container px-3 py-2 text-sm text-primary focus-ring" %>
        </div>
        <div>
          <%= f.label :term, t(".filter.term"), class: "block text-xs text-secondary" %>
          <%= f.select :term, [ [ t(".filter.any_term"), "" ], [ t(".term.short"), "short" ], [ t(".term.long"), "long" ] ], { selected: review.term.to_s }, class: "mt-1 rounded-lg border border-tertiary bg-container px-3 py-2 text-sm text-primary focus-ring" %>
        </div>
        <%= f.submit t(".filter.apply"), class: "rounded-lg border border-tertiary px-4 py-2 text-sm font-medium text-primary cursor-pointer" %>
        <% if review.filtered? %><%= link_to t(".filter.clear"), tax_lot_review_path, class: "py-2 text-sm text-secondary hover:underline", data: { turbo_frame: "investment_workspace" } %><% end %>
      <% end %>
      <% if review.filtered? %>
        <p class="text-xs text-secondary" data-testid="lots-filter-note" role="status"><%= review.visible_lots.empty? ? t(".filter.none_match") : t(".filter.showing", shown: review.visible_lots.size, total: review.lots.size) %></p>
      <% end %>
      <div class="overflow-x-auto rounded-xl bg-container shadow-border-xs">
        <table class="w-full min-w-[52rem] text-sm" data-testid="lots-table">
          <caption class="sr-only"><%= t(".lots_caption") %></caption>
          <thead class="border-b border-tertiary text-left text-xs uppercase tracking-wide text-secondary">
            <tr>
              <th scope="col" class="px-4 py-3"><%= sort_link.call(t(".columns.ticker"), "ticker") %></th>
              <th scope="col" class="px-4 py-3"><%= sort_link.call(t(".columns.account"), "account") %></th>
              <th scope="col" class="px-4 py-3"><%= sort_link.call(t(".columns.acquired"), "acquired") %></th>
              <th scope="col" class="px-4 py-3"><%= sort_link.call(t(".columns.term"), "term") %></th>
              <th scope="col" class="px-4 py-3 text-right"><%= sort_link.call(t(".columns.quantity"), "quantity", align: "right") %></th>
              <th scope="col" class="px-4 py-3 text-right"><%= sort_link.call(t(".columns.cost_basis"), "cost_basis", align: "right") %></th>
              <th scope="col" class="px-4 py-3 text-right"><%= sort_link.call(t(".columns.value"), "market_value", align: "right") %></th>
              <th scope="col" class="px-4 py-3 text-right"><%= sort_link.call(t(".columns.gain"), "gain", align: "right") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-tertiary">
            <% review.visible_lots.each do |lot| %>
              <tr>
                <td class="px-4 py-3 font-mono font-medium"><%= link_to lot.ticker, research_ticker_path(lot.ticker), class: "hover:underline" %></td>
                <td class="px-4 py-3"><%= lot.account.name %></td>
                <td class="px-4 py-3"><%= l(lot.acquired_on) %></td>
                <td class="px-4 py-3"><%= t(".term.#{lot.term}") %></td>
                <td class="px-4 py-3 text-right font-mono"><%= investment_quantity(lot.quantity) %></td>
                <td class="px-4 py-3 text-right font-mono"><%= investment_money(lot.cost_basis, lot.currency) %></td>
                <td class="px-4 py-3 text-right font-mono"><%= investment_money(lot.market_value, lot.currency) %></td>
                <td class="px-4 py-3 text-right font-mono"><%= investment_gain(lot.gain, lot.currency, percent: lot.gain_pct) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
  <% end %>
</div>
<% end %>
