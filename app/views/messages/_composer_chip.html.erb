<%# locals: (icon_name:) %>
<span role="listitem" data-composer-chip
      class="inline-flex items-center gap-1.5 max-w-full rounded-full bg-surface-inset shadow-border-xs pl-2.5 pr-1 py-1 text-sm text-primary">
  <%= icon(icon_name, size: "xs", color: "current", class: "text-secondary") %>
  <span class="truncate" data-chip-label></span>
  <button type="button" class="shrink-0 grid place-items-center w-5 h-5 rounded-full text-secondary hover:bg-surface-hover hover:text-primary focus-visible:outline-2"
          data-chip-remove data-action="click->chat-composer#removeChip">
    <%= icon("x", size: "xs", color: "current") %>
  </button>
</span>
