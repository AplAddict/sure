<% content_for :page_title, t(".title") %>
<% totals = @harvest.totals %>
<% realized = @harvest.realized_year_to_date %>
<% unmeasured = realized[:unknown] %>

<div class="space-y-5 pb-8">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-xs font-medium uppercase tracking-wide text-secondary"><%= t(".eyebrow") %></p>
      <h1 class="text-2xl font-semibold text-primary"><%= t(".title") %></h1>
      <p class="mt-1 max-w-3xl text-sm text-secondary"><%= t(".subtitle") %></p>
    </div>
    <div class="flex items-center gap-3">
      <%= render DS::Link.new(text: t(".events_link"), href: market_events_path(type: "wash_sale"), variant: "outline", size: "sm") %>
      <%= render DS::Link.new(text: t(".research_link"), href: research_search_path, variant: "outline", size: "sm") %>
    </div>
  </div>

  <% if @harvest.accounts.empty? %>
    <div class="rounded-xl bg-container shadow-border-xs">
      <%= render DS::EmptyState.new(icon: "landmark", title: t(".no_accounts.title"), description: t(".no_accounts.description")) %>
    </div>
  <% else %>
    <div class="grid grid-cols-2 gap-2 lg:grid-cols-4">
      <div class="rounded-xl bg-container p-3 shadow-border-xs">
        <p class="text-xs text-secondary"><%= t(".summary.candidates") %></p>
        <p class="mt-1 text-xl font-semibold text-primary"><%= totals.candidate_count %></p>
        <p class="text-xs text-subdued"><%= t(".summary.candidates_hint", pct: TaxLossHarvest::CANDIDATE_LOSS_PCT.to_i) %></p>
      </div>
      <div class="rounded-xl bg-container p-3 shadow-border-xs">
        <p class="text-xs text-secondary"><%= t(".summary.total_loss") %></p>
        <p class="mt-1 text-xl font-semibold text-primary privacy-sensitive"><%= totals.loss.format %></p>
        <p class="text-xs text-subdued"><%= t(".summary.total_loss_hint") %></p>
      </div>
      <div class="rounded-xl bg-container p-3 shadow-border-xs">
        <p class="text-xs text-secondary"><%= t(".summary.short_term") %></p>
        <p class="mt-1 text-xl font-semibold text-primary privacy-sensitive"><%= totals.short_term_loss.format %></p>
        <p class="text-xs text-subdued"><%= t(".summary.long_term") %>: <span class="privacy-sensitive"><%= totals.long_term_loss.format %></span></p>
        <% if totals.unknown_term_loss.amount.positive? %>
          <p class="text-xs text-warning"><%= t(".summary.unknown_term") %>: <span class="privacy-sensitive"><%= totals.unknown_term_loss.format %></span></p>
        <% end %>
      </div>
      <div class="rounded-xl bg-container p-3 shadow-border-xs">
        <p class="text-xs text-secondary"><%= t(".summary.realized") %></p>
        <p class="mt-1 text-xl font-semibold text-primary privacy-sensitive"><%= realized[:amount].format %></p>
        <p class="text-xs <%= unmeasured.positive? ? "text-warning" : "text-subdued" %>">
          <%= unmeasured.positive? ? t(".summary.realized_hint", count: unmeasured) : t(".summary.realized_known") %>
        </p>
      </div>
    </div>

    <div class="rounded-xl border border-warning/30 bg-warning/10 p-4 text-sm">
      <p class="font-medium text-primary"><%= t(".boundary.title") %></p>
      <p class="mt-1 text-secondary"><%= t(".boundary.body") %></p>
      <% if @harvest.excluded_account_count.positive? %>
        <p class="mt-2 text-secondary"><%= t(".scope_note", count: @harvest.excluded_account_count) %></p>
      <% end %>
    </div>

    <% if @harvest.rows.empty? %>
      <div class="rounded-xl bg-container shadow-border-xs">
        <%= render DS::EmptyState.new(icon: "circle-check", title: t(".empty.title"), description: t(".empty.description")) %>
      </div>
    <% else %>
      <div class="overflow-hidden rounded-xl bg-container shadow-border-xs">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[56rem] text-sm">
            <caption class="sr-only"><%= t(".table.caption") %></caption>
            <thead class="bg-container-inset text-xs uppercase tracking-wide text-secondary">
              <tr>
                <th scope="col" class="px-4 py-2 text-left font-medium"><%= t(".table.security") %></th>
                <th scope="col" class="px-4 py-2 text-left font-medium"><%= t(".table.account") %></th>
                <th scope="col" class="px-4 py-2 text-right font-medium"><%= t(".table.value") %></th>
                <th scope="col" class="px-4 py-2 text-right font-medium"><%= t(".table.cost") %></th>
                <th scope="col" class="px-4 py-2 text-right font-medium"><%= t(".table.loss") %></th>
                <th scope="col" class="px-4 py-2 text-left font-medium"><%= t(".table.term") %></th>
                <th scope="col" class="px-4 py-2 text-left font-medium"><%= t(".table.status") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-tertiary">
              <% @harvest.rows.each do |row| %>
                <tr class="align-top">
                  <td class="px-4 py-3">
                    <div class="flex flex-wrap items-center gap-2">
                      <%= link_to row.ticker, research_ticker_path(row.ticker), class: "font-semibold text-link hover:underline" %>
                      <% if row.candidate %><%= render DS::Pill.new(label: t(".table.candidate"), tone: :warning, marker: false, size: :sm) %><% end %>
                    </div>
                    <p class="max-w-[14rem] truncate text-xs text-secondary"><%= row.name %></p>
                  </td>
                  <td class="px-4 py-3 text-secondary"><%= link_to row.account.name, account_path(row.account), class: "hover:underline" %></td>
                  <td class="px-4 py-3 text-right font-mono privacy-sensitive"><%= row.market_value.format %></td>
                  <td class="px-4 py-3 text-right font-mono privacy-sensitive"><%= row.cost_basis.format %></td>
                  <td class="px-4 py-3 text-right font-mono text-primary">
                    <span class="privacy-sensitive"><%= row.loss.format %></span>
                    <% if row.loss_pct %><p class="text-xs text-secondary"><%= number_to_percentage(row.loss_pct, precision: 1) %></p><% end %>
                  </td>
                  <td class="px-4 py-3">
                    <% if row.term == :unknown %>
                      <%= render DS::Pill.new(label: t(".term.unknown"), tone: :neutral, marker: false, size: :sm, title: t(".term.unknown_hint")) %>
                    <% elsif row.term == :mixed %>
                      <%= render DS::Pill.new(label: t(".term.mixed"), tone: :info, marker: false, size: :sm) %>
                      <p class="mt-1 text-xs text-secondary"><%= t(".term.mixed_detail", long: row.long_term_qty.round(4).to_s("F"), short: row.short_term_qty.round(4).to_s("F")) %></p>
                    <% else %>
                      <%= render DS::Pill.new(label: t(".term.#{row.term}"), tone: row.term == :long ? :success : :neutral, marker: false, size: :sm) %>
                    <% end %>
                    <% if row.first_acquired %><p class="mt-1 text-xs text-subdued"><%= l(row.first_acquired, format: :long) %></p><% end %>
                  </td>
                  <td class="px-4 py-3 text-xs">
                    <% if row.wash_flags.empty? %>
                      <span class="text-secondary"><%= t(".flags.clear") %></span>
                    <% else %>
                      <ul class="space-y-1">
                        <% row.wash_flags.each do |flag| %>
                          <li class="text-warning">
                            <% case flag.kind %>
                            <% when :recent_purchase %>
                              <%= t(".flags.recent_purchase", date: l(flag.date, format: :short), qty: flag.detail.round(4).to_s("F")) %>
                              <span class="block text-secondary"><%= t(".flags.recent_purchase_ends", date: l(flag.end_date, format: :short)) %></span>
                            <% when :held_elsewhere %>
                              <%= t(".flags.held_elsewhere", accounts: flag.detail.to_sentence) %>
                            <% when :open_window %>
                              <%= t(".flags.open_window", date: l(flag.end_date, format: :short)) %>
                            <% end %>
                          </li>
                        <% end %>
                      </ul>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <% if @harvest.unavailable.any? %>
      <div class="rounded-xl bg-container shadow-border-xs">
        <div class="border-b border-tertiary px-4 py-3">
          <h2 class="text-sm font-medium text-primary"><%= t(".unavailable.title") %> · <%= @harvest.unavailable.size %></h2>
          <p class="text-xs text-secondary"><%= t(".unavailable.description") %></p>
        </div>
        <ul class="divide-y divide-tertiary">
          <% @harvest.unavailable.each do |item| %>
            <li class="flex items-center justify-between gap-3 px-4 py-2 text-sm">
              <span class="min-w-0 truncate">
                <%= link_to item.ticker, research_ticker_path(item.ticker), class: "font-semibold text-link hover:underline" %>
                <span class="text-secondary"> · <%= item.account.name %></span>
              </span>
              <span class="shrink-0 text-xs text-warning"><%= t(".unavailable.#{item.reason}") %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>
</div>
