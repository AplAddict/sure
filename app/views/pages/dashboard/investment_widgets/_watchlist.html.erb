<%# locals: (status_counts:, priority_count:) %>
<div class="space-y-4" data-testid="watchlist-widget">
  <div class="grid grid-cols-2 gap-3"><%= investment_stat(t("pages.dashboard.investment_widgets.priority_items"), priority_count) %><%= investment_stat(t("pages.dashboard.investment_widgets.total_watchlist"), status_counts.values.sum) %></div>
  <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm"><% status_counts.each do |status, count| %><li class="flex justify-between gap-2"><span class="text-secondary"><%= status.humanize %></span><span class="text-primary"><%= count %></span></li><% end %></ul>
  <p class="text-xs text-secondary"><%= t("pages.dashboard.investment_widgets.watchlist_edit_hint") %></p>
</div>
