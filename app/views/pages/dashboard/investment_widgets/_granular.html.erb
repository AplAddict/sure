<%# locals: (widget_data:, **args) %>
<div class="min-w-0 space-y-3 overflow-hidden" data-testid="granular-investment-widget">
  <% metrics = Array(widget_data[:metrics]) %>
  <% if metrics.any? %>
    <div class="grid min-w-0 grid-cols-1 gap-2 sm:grid-cols-2">
      <% metrics.each do |metric| %>
        <%= render "pages/dashboard/widgets/kpi_tile", label: metric[:label], value: metric[:value], hint: metric[:hint], tone: metric[:tone] || "text-primary" %>
      <% end %>
    </div>
  <% end %>

  <% rows = Array(widget_data[:rows]) %>
  <% if rows.any? %>
    <%= render "pages/dashboard/widgets/mini_table", rows: rows %>
  <% elsif metrics.empty? %>
    <%= render "pages/dashboard/widgets/empty_state", message: t("pages.dashboard.granular_data.no_data") %>
  <% end %>
</div>
