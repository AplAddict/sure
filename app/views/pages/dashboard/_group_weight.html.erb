<%# locals: (weight:, color:) %>

<% segments = weight.nil? ? 0 : (weight / 20.0).ceil %>

<div class="w-full flex items-center justify-between gap-2">
  <div class="flex gap-[3px]">
    <% 5.times do |i| %>
      <div class="w-0.5 h-2.5 rounded-lg <%= i < segments ? "" : "opacity-20" %>" style="background-color: <%= color %>;"></div>
    <% end %>
  </div>
  <p class="text-sm whitespace-nowrap privacy-sensitive"><%= format_optional_percentage(weight, precision: 0) %></p>
</div>
