<%# locals: (articles:, widget_id: "ticker-news", news_settings: {}, news_url: research_news_path) %>
<% density = news_settings.fetch("density", "compact") %>
<div id="<%= widget_id %>" class="px-4">
  <div class="divide-y divide-tertiary">
    <% articles.each do |article| %>
      <article class="py-2 text-sm">
        <div class="flex min-w-0 items-start justify-between gap-3">
          <div class="min-w-0 grow">
            <%= link_to article[:url], target: "_blank", rel: "noopener noreferrer", class: "block truncate font-medium text-link focus-ring" do %><%= article[:title] %><% end %>
            <p class="mt-0.5 truncate text-xs text-secondary"><%= [ article[:source], article[:tickers].presence&.join(", ") ].compact.join(" · ") %></p>
          </div>
          <span class="shrink-0 text-xs tabular-nums text-secondary">
            <% if article[:published_at].present? %>
              <%= l(article[:published_at], format: :short) %>
            <% else %>
              <span aria-hidden="true"><%= unavailable_cell %></span><span class="sr-only"><%= t("pages.dashboard.ticker_news.time_unavailable") %></span>
            <% end %>
          </span>
        </div>
        <% if density == "detail" && article[:description].present? %><p class="mt-1 line-clamp-2 text-xs text-secondary"><%= article[:description] %></p><% end %>
        <% if article[:headline_sentiments].present? %><div class="mt-1"><%= render "holdings/headline_sentiments", sentiments: article[:headline_sentiments] %></div><% end %>
      </article>
    <% end %>
  </div>
  <div class="pt-2"><%= link_to t("pages.dashboard.ticker_news.view_all"), news_url, class: "text-sm font-medium text-link focus-ring" %></div>
</div>
