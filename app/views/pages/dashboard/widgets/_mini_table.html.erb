<%# locals: (rows:) %>
<ul class="min-w-0 divide-y divide-tertiary" role="list">
  <% rows.each do |row| %>
    <li class="flex min-w-0 items-start justify-between gap-3 py-2 text-sm">
      <div class="min-w-0">
        <% if row[:href] %>
          <%= link_to row[:primary], row[:href], class: "block truncate font-medium text-primary underline-offset-2 hover:underline focus-ring", target: "_blank", rel: "noopener noreferrer" %>
        <% else %>
          <p class="truncate font-medium text-primary"><%= row[:primary] %></p>
        <% end %>
        <% if row[:detail].present? %><p class="truncate text-xs text-secondary"><%= row[:detail] %></p><% end %>
        <% if row[:progress] %><%= render "pages/dashboard/widgets/progress_bar", value: row[:progress], label: row[:primary] %><% end %>
      </div>
      <% if row[:secondary].present? %>
        <span class="block shrink-0 text-right tabular-nums <%= row[:tone].presence || "text-secondary" %>"><%= row[:secondary] %></span>
      <% end %>
    </li>
  <% end %>
</ul>
