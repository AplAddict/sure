<%# locals: (settings:, field_id_prefix:) %>
<% active_scope = settings.find { |candidate| candidate[:key] == "scope" }&.dig(:value) %>
<% settings.each do |setting| %>
  <% field_id = "#{field_id_prefix}-#{setting[:key]}" %>
  <% help_id = "#{field_id}-help" %>
  <% conditional_identifier = %w[account_id security_id].include?(setting[:key]) %>
  <% relevant = !conditional_identifier || active_scope == setting[:key].delete_suffix("_id") %>
  <%= tag.div(
        hidden: !relevant,
        data: conditional_identifier ? { widget_settings_target: "#{setting[:key].delete_suffix("_id")}Field" } : {}
      ) do %>
    <%= tag.label t("pages.dashboard.settings.labels.#{setting[:key]}"), class: "mb-1 block text-xs font-medium text-secondary", for: field_id %>
    <% if setting[:type] == "integer" %>
      <%= number_field_tag setting[:key], setting[:value], id: field_id, class: "form-field__input", min: setting[:minimum], max: setting[:maximum], aria: { describedby: help_id }, data: { setting_type: "integer", default_value: setting[:default] } %>
    <% else %>
      <% options = setting[:options] %>
      <% options = [[t("pages.dashboard.settings.none"), ""]] + options if setting[:type] == "identifier" %>
      <% select_data = { setting_type: setting[:type], default_value: setting[:default] } %>
      <% if setting[:key] == "scope" %>
        <% select_data.merge!(widget_settings_target: "scope", action: "change->widget-settings#scopeChanged") %>
      <% end %>
      <%= select_tag setting[:key], options_for_select(options, setting[:value]), id: field_id, class: "form-field__input", disabled: conditional_identifier && !relevant, aria: { describedby: help_id }, data: select_data %>
    <% end %>
    <%= tag.p t("pages.dashboard.settings.help.#{setting[:key]}"), id: help_id, class: "mt-1 text-xs text-secondary" %>
  <% end %>
<% end %>
