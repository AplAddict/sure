<%# locals: (id:, url:, page_key:, widgets:) %>
<%= render DS::Dialog.new(id: id, auto_open: false, disable_frame: true, data: { testid: "dashboard-add-widget-dialog", expandable_target: "dialog" }) do |dialog| %>
  <% dialog.with_header(title: t("pages.dashboard.widgets.add_title"), subtitle: t("pages.dashboard.widgets.add_description")) %>
  <% dialog.with_body do %>
    <% if widgets.empty? %>
      <%= render DS::EmptyState.new(icon: "layout-grid", title: t("pages.dashboard.widgets.none_left_title"), description: t("pages.dashboard.widgets.none_left_description")) %>
    <% else %>
      <ul class="divide-y divide-tertiary" data-testid="dashboard-widget-catalog">
        <% widgets.each do |widget| %>
          <li class="flex items-center justify-between gap-3 py-3">
            <div class="min-w-0">
              <p class="text-sm font-medium text-primary"><%= widget[:title] %></p>
              <% if widget[:description].present? %>
                <p class="text-xs text-secondary"><%= widget[:description] %></p>
              <% end %>
            </div>
            <button type="button"
                    class="shrink-0 cursor-pointer rounded-lg border border-tertiary px-3 py-1.5 text-sm font-medium text-primary hover:bg-container-inset-hover focus-ring pointer-coarse:py-2.5"
                    data-action="click->dashboard-pages#addWidget"
                    data-url="<%= url %>"
                    data-widget-key="<%= widget[:key] %>"
                    data-page-key="<%= page_key %>"
                    aria-label="<%= t("pages.dashboard.widgets.add_to_page", title: widget[:title]) %>">
              <%= t("pages.dashboard.widgets.add") %>
            </button>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
<% end %>
