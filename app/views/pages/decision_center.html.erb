<% center = @decision_center %>
<% pulse = center.pulse %>
<% actions = center.actions %>
<% top_holdings = center.top_holdings %>
<% source_health = center.source_health %>
<% content_for :page_title, t("investment_decision_center.title") %>

<% content_for :page_header do %>
  <div class="space-y-1 mb-6 flex gap-4 justify-between items-center lg:items-start">
    <div class="space-y-1">
      <h1 class="text-xl lg:text-3xl font-medium text-primary"><%= t("investment_decision_center.title") %></h1>
      <p class="text-sm lg:text-base text-secondary max-w-3xl"><%= t("investment_decision_center.subtitle") %></p>
    </div>
    <div class="flex items-center gap-2">
      <%= render "pages/dashboard/view_switch", active: "decision" %>
    </div>
  </div>
<% end %>

<div class="space-y-5 pb-6 lg:pb-12">
  <section class="rounded-xl bg-container shadow-border-xs p-4 space-y-4" aria-labelledby="idc-pulse">
    <% if pulse.nil? %>
      <h2 id="idc-pulse" class="text-base font-medium text-primary"><%= t("investment_decision_center.pulse.heading") %></h2>
      <p class="text-sm text-secondary" data-testid="idc-pulse-unavailable"><%= t("investment_decision_center.section_unavailable") %></p>
    <% else %>
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="idc-pulse" class="text-base font-medium text-primary"><%= t("investment_decision_center.pulse.heading") %></h2>
      <% if pulse.as_of %>
        <p class="text-xs <%= pulse.stale ? "text-warning" : "text-secondary" %>">
          <%= pulse.stale ? t("investment_decision_center.pulse.stale", date: l(pulse.as_of, format: :long)) : t("investment_decision_center.pulse.as_of", date: l(pulse.as_of, format: :long)) %>
        </p>
      <% else %>
        <p class="text-xs text-warning"><%= t("investment_decision_center.pulse.no_holdings_date") %></p>
      <% end %>
    </div>

    <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
      <div>
        <p class="text-xs text-secondary"><%= t("investment_decision_center.pulse.portfolio_value") %></p>
        <p class="mt-1 text-2xl font-medium text-primary privacy-sensitive"><%= format_money(pulse.portfolio_value) %></p>
        <p class="text-xs text-subdued"><span class="privacy-sensitive"><%= format_money(pulse.holdings_value) %></span> · <%= t("investment_decision_center.pulse.holdings") %></p>
      </div>
      <div>
        <p class="text-xs text-secondary"><%= t("investment_decision_center.pulse.cash") %></p>
        <p class="mt-1 text-2xl font-medium text-primary privacy-sensitive"><%= format_money(pulse.cash_balance) %></p>
      </div>
      <div>
        <p class="text-xs text-secondary"><%= t("investment_decision_center.pulse.day_change") %></p>
        <% if pulse.day_change %>
          <p class="mt-1 text-2xl font-medium privacy-sensitive" style="color: <%= pulse.day_change.color %>"><%= format_money(pulse.day_change.value) %></p>
          <p class="text-xs text-secondary"><%= pulse.day_change.percent_formatted %></p>
        <% else %>
          <p class="mt-1 text-2xl font-medium text-secondary" title="<%= t("investment_decision_center.pulse.unavailable_hint") %>">—</p>
          <p class="text-xs text-subdued"><%= t("investment_decision_center.pulse.unavailable") %></p>
        <% end %>
      </div>
      <div>
        <p class="text-xs text-secondary"><%= t("investment_decision_center.pulse.unrealized") %></p>
        <% if pulse.unrealized %>
          <p class="mt-1 text-2xl font-medium privacy-sensitive" style="color: <%= pulse.unrealized.color %>"><%= format_money(pulse.unrealized.value) %></p>
          <p class="text-xs text-secondary"><%= pulse.unrealized.percent_formatted %></p>
        <% else %>
          <p class="mt-1 text-2xl font-medium text-secondary" title="<%= t("investment_decision_center.pulse.unavailable_hint") %>">—</p>
          <p class="text-xs text-subdued"><%= t("investment_decision_center.pulse.unavailable") %></p>
        <% end %>
      </div>
    </div>
    <% end %>
  </section>

  <section class="rounded-xl bg-container shadow-border-xs" aria-labelledby="idc-source-health" data-testid="idc-source-health">
    <div class="px-4 py-3 border-b border-tertiary"><h2 id="idc-source-health" class="text-base font-medium text-primary">Data health</h2><p class="text-xs text-secondary">Freshness and availability for the evidence already shown above.</p></div>
    <% if source_health.nil? %>
      <p class="px-4 py-4 text-sm text-secondary"><%= t("investment_decision_center.section_unavailable") %></p>
    <% else %>
      <ul class="divide-y divide-tertiary"><% source_health.each do |source| %><li class="flex items-center justify-between gap-3 px-4 py-3"><div><p class="text-sm font-medium text-primary"><%= source.label %></p><p class="text-xs text-secondary"><%= source.detail %></p></div><span class="rounded-full px-2 py-1 text-xs font-medium <%= source.status == "current" ? "bg-success-subtle text-success" : source.status == "stale" ? "bg-warning-subtle text-warning" : "bg-destructive-subtle text-destructive" %>"><%= source.status.humanize %></span></li><% end %></ul>
    <% end %>
  </section>

  <section class="rounded-xl bg-container shadow-border-xs" aria-labelledby="idc-actions">
    <div class="px-4 py-3 border-b border-tertiary">
      <h2 id="idc-actions" class="text-base font-medium text-primary"><%= t("investment_decision_center.actions.heading") %></h2>
    </div>

    <% if actions.nil? %>
      <p class="px-4 py-6 text-sm text-secondary" data-testid="idc-actions-unavailable"><%= t("investment_decision_center.section_unavailable") %></p>
    <% elsif actions.empty? %>
      <%= render DS::EmptyState.new(
        icon: "circle-check",
        title: t("investment_decision_center.actions.none_title"),
        description: t("investment_decision_center.actions.none_description")
      ) %>
    <% else %>
      <ul class="divide-y divide-tertiary">
        <% actions.each do |action| %>
          <% href = case action.kind
                    when :harvest, :cost_basis then tax_loss_harvest_path
                    when :wash_sale then market_events_path(type: "wash_sale")
                    when :events then market_events_path
                    end %>
          <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
            <div class="min-w-0">
              <p class="text-sm font-medium text-primary"><%= t("investment_decision_center.actions.#{action.kind}.title") %></p>
              <p class="text-xs text-secondary">
                <% case action.kind %>
                <% when :harvest %>
                  <span class="privacy-sensitive"><%= t("investment_decision_center.actions.harvest.detail", count: action.count, loss: action.detail.format) %></span>
                <% when :wash_sale %>
                  <%= t("investment_decision_center.actions.wash_sale.detail", count: action.count) %><% if action.detail.positive? %> · <%= t("investment_decision_center.actions.wash_sale.replaced", count: action.detail) %><% end %>
                <% when :events %>
                  <%= t("investment_decision_center.actions.events.detail", count: action.count, tickers: action.detail.to_sentence) %>
                <% when :cost_basis %>
                  <%= t("investment_decision_center.actions.cost_basis.detail", count: action.count, tickers: action.detail.to_sentence) %>
                <% end %>
              </p>
            </div>
            <%= render DS::Link.new(text: t("investment_decision_center.actions.review"), href: href, variant: "outline", size: "sm") %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <p class="px-4 py-2 text-xs text-secondary bg-container-inset rounded-b-xl"><%= t("investment_decision_center.actions.boundary") %></p>
  </section>

  <section class="rounded-xl bg-container shadow-border-xs" aria-labelledby="idc-monitor">
    <div class="px-4 py-3 border-b border-tertiary">
      <h2 id="idc-monitor" class="text-base font-medium text-primary"><%= t("investment_decision_center.monitor.heading") %></h2>
    </div>

    <% if top_holdings.nil? %>
      <p class="px-4 py-6 text-sm text-secondary" data-testid="idc-monitor-unavailable"><%= t("investment_decision_center.section_unavailable") %></p>
    <% elsif top_holdings.empty? %>
      <p class="px-4 py-6 text-sm text-secondary"><%= t("investment_decision_center.monitor.empty") %></p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-container-inset text-xs uppercase text-secondary">
            <tr>
              <th scope="col" class="px-4 py-2 text-left font-medium"><%= t("investment_decision_center.monitor.holding") %></th>
              <th scope="col" class="px-4 py-2 text-right font-medium"><%= t("investment_decision_center.monitor.weight") %></th>
              <th scope="col" class="px-4 py-2 text-right font-medium"><%= t("investment_decision_center.monitor.value") %></th>
              <th scope="col" class="px-4 py-2 text-right font-medium"><%= t("investment_decision_center.monitor.return") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-tertiary">
            <% top_holdings.each do |holding| %>
              <tr>
                <td class="px-4 py-3">
                  <div class="flex flex-wrap items-center gap-2">
                    <%= link_to holding.ticker, research_ticker_path(holding.ticker), class: "font-semibold text-link hover:underline" %>
                    <% if center.concentrated?(holding) %>
                      <%= render DS::Pill.new(label: t("investment_decision_center.monitor.concentrated"), tone: :warning, marker: false, size: :sm) %>
                    <% end %>
                  </div>
                  <p class="max-w-[16rem] truncate text-xs text-secondary"><%= holding.name %></p>
                </td>
                <td class="px-4 py-3 text-right font-mono"><%= number_to_percentage(holding.weight, precision: 1) %></td>
                <td class="px-4 py-3 text-right font-mono privacy-sensitive"><%= format_money(holding.amount) %></td>
                <td class="px-4 py-3 text-right font-mono">
                  <% if holding.trend %>
                    <span class="privacy-sensitive" style="color: <%= holding.trend.color %>"><%= format_money(holding.trend.value) %></span>
                    <p class="text-xs text-secondary"><%= holding.trend.percent_formatted %></p>
                  <% else %>
                    <span class="text-secondary" title="<%= t("investment_decision_center.monitor.return_unavailable") %>">—</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>

  <section aria-labelledby="idc-links">
    <h2 id="idc-links" class="sr-only"><%= t("investment_decision_center.links.heading") %></h2>
    <div class="flex flex-wrap gap-2">
      <%= render DS::Link.new(text: t("investment_decision_center.links.harvest"), href: tax_loss_harvest_path, variant: "outline", size: "sm") %>
      <%= render DS::Link.new(text: t("investment_decision_center.links.events"), href: market_events_path, variant: "outline", size: "sm") %>
      <%= render DS::Link.new(text: t("investment_decision_center.links.holdings"), href: portfolio_holdings_path, variant: "outline", size: "sm") %>
      <%= render DS::Link.new(text: t("investment_decision_center.links.research"), href: research_search_path, variant: "outline", size: "sm") %>
      <%= render DS::Link.new(text: t("investment_decision_center.links.reports"), href: reports_path, variant: "outline", size: "sm") %>
      <% if preview_features_enabled? %>
        <%= render DS::Link.new(text: t("investment_decision_center.links.insights"), href: insights_path, variant: "outline", size: "sm", data: { turbo_prefetch: false }) %>
      <% end %>
    </div>
  </section>
</div>
