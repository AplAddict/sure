<% center = @decision_center %>
<% content_for :page_title, t("investment_decision_center.title") %>

<%= turbo_frame_tag "investment_workspace", target: "_top" do %>
  <div class="space-y-1 mb-6 flex gap-4 justify-between items-center lg:items-start">
    <div class="space-y-1">
      <h1 class="text-xl lg:text-3xl font-medium text-primary"><%= t("investment_decision_center.title") %></h1>
      <p class="text-sm lg:text-base text-secondary max-w-3xl"><%= t("investment_decision_center.subtitle") %></p>
    </div>
    <div class="flex items-center gap-2">
      <%= render "pages/dashboard/view_switch", active: "decision" %>
    </div>
  </div>
  <div class="space-y-5 pb-6 lg:pb-12">
  <%= render "investments/subnav", current: :decision %>

  <%= render "investments/sections",
        sections: InvestmentSections.new(namespace: "decision", user: Current.user, definitions: [
          { key: "pulse", title: t("investment_decision_center.pulse.heading"),
            partial: "pages/decision_center/pulse", locals: { pulse: center.pulse } },
          { key: "source_health", title: t("investment_decision_center.source_health.heading"), flush: true,
            partial: "pages/decision_center/source_health", locals: { source_health: center.source_health } },
          { key: "actions", title: t("investment_decision_center.actions.heading"), flush: true,
            partial: "pages/decision_center/actions", locals: { actions: center.actions } },
          { key: "monitor", title: t("investment_decision_center.monitor.heading"), flush: true,
            partial: "pages/decision_center/monitor", locals: { top_holdings: center.top_holdings, center: center } }
        ]),
        namespace: "decision",
        url: investment_section_preferences_path("decision"), preference_key: "investments_decision" %>

  <section aria-labelledby="idc-links">
    <h2 id="idc-links" class="sr-only"><%= t("investment_decision_center.links.heading") %></h2>
    <div class="flex flex-wrap gap-2">
      <%= render DS::Link.new(text: t("investment_decision_center.links.research"), href: research_search_path, variant: "outline", size: "sm") %>
      <%= render DS::Link.new(text: t("investment_decision_center.links.reports"), href: reports_path, variant: "outline", size: "sm") %>
      <% if preview_features_enabled? %>
        <%= render DS::Link.new(text: t("investment_decision_center.links.insights"), href: insights_path, variant: "outline", size: "sm", data: { turbo_prefetch: false }) %>
      <% end %>
    </div>
  </section>
</div>
<% end %>
