<% content_for :page_title, (@dashboard_page_id == "investments" ? t("investment_decision_center.title") : @dashboard_page.fetch("name")) %>

<% content_for :page_header do %>
  <div class="mb-6 flex items-center justify-between gap-4 lg:items-start">
    <div class="space-y-1">
      <h1 class="text-xl font-medium text-primary lg:text-3xl">
        <% if @dashboard_page_id == "home" %>
          <%= t("pages.dashboard.welcome", name: Current.user.first_name) %>
        <% elsif @dashboard_page_id == "investments" %>
          <%= t("investment_decision_center.title") %>
        <% else %>
          <%= @dashboard_page.fetch("name") %>
        <% end %>
      </h1>
      <p class="text-sm text-secondary lg:text-base">
        <%= @dashboard_page_id == "investments" ? t("investment_decision_center.subtitle") : t("pages.dashboard.subtitle") %>
      </p>
    </div>

    <%= render "pages/dashboard/header_actions",
          add_widget: @dashboard_add_widget,
          page_management: @dashboard_page_management,
          current_page_url: root_path(page: @dashboard_page_id),
          home_url: root_path %>
  </div>
<% end %>

<%= turbo_frame_tag "dashboard_sections", target: "_top" do %>
  <%= render "pages/dashboard/page_tabs", pages: @dashboard_tabs, current: @dashboard_page_id, can_create: @dashboard_page_management[:can_create] %>

  <% if @accounts.any? %>
    <div class="mb-4 flex items-center justify-end">
      <%= render UI::PeriodPicker.new(selected: @period, url: root_path(page: @dashboard_page_id), frame: "dashboard_sections") %>
    </div>
  <% elsif @dashboard_page_id == "home" %>
    <div class="mb-6"><%= render "pages/dashboard/no_accounts_graph_placeholder" %></div>
  <% end %>

  <% if @dashboard_sections.empty? %>
    <%= render "pages/dashboard/empty_page",
          title: t("pages.dashboard.empty_page.title"),
          description: t("pages.dashboard.empty_page.description"),
          add_widget: @dashboard_add_widget,
          current_page_url: root_path(page: @dashboard_page_id) %>
  <% else %>
    <% two_column = Current.user.dashboard_two_column? %>
    <div data-controller="dashboard-pages" data-dashboard-pages-return-url-value="<%= root_path(page: @dashboard_page_id) %>">
      <%= render "pages/dashboard/local_error", id: "dashboard-page-alert", scope: "page", testid: "dashboard-page-alert" %>
      <p id="dashboard-reorder-instructions" class="sr-only"><%= t("pages.dashboard.reorder_instructions") %></p>
      <div class="grid grid-cols-1 gap-6 pb-6 lg:pb-12 <%= "2xl:grid-cols-12 2xl:items-start 2xl:gap-y-0 2xl:[grid-auto-flow:row_dense] 2xl:[grid-auto-rows:1px]" if two_column %>"
         data-controller="dashboard-sortable dashboard-masonry"
         data-dashboard-sortable-url-value="<%= order_page_widgets_path(@dashboard_page_id) %>"
         data-dashboard-sortable-moved-template-value="<%= t("pages.dashboard.reorder_moved") %>"
         data-action="dragover->dashboard-sortable#dragOver drop->dashboard-sortable#drop"
         role="list"
         aria-label="<%= t("pages.dashboard.sections_aria_label") %>">
      <p class="sr-only" role="listitem" aria-live="polite" aria-atomic="true" data-dashboard-sortable-target="announcement"></p>
      <% @dashboard_sections.each do |section| %>
        <%= render layout: "pages/dashboard/widgets/card", locals: { section: section, two_column: two_column } do %>
          <div class="flex items-center justify-between px-4 py-2">
            <div class="flex min-w-0 items-center gap-2">
              <button type="button"
                      class="flex h-6 w-6 items-center justify-center rounded-md text-secondary transition-colors hover:bg-container-inset-hover hover:text-primary focus-ring pointer-coarse:h-11 pointer-coarse:w-11"
                      data-action="click->dashboard-section#toggle keydown->dashboard-section#handleToggleKeydown"
                      data-dashboard-section-target="button"
                      aria-label="<%= t("pages.dashboard.toggle_section") %>"
                      aria-expanded="<%= !section[:collapsed] %>">
                <%= icon("chevron-down", size: "sm", class: "transition-transform", data: { dashboard_section_target: "chevron" }) %>
              </button>
              <div class="min-w-0">
                <h2 class="truncate text-base font-medium"><%= t(section[:title]) %></h2>
                <% visible_meta = [section[:scope_label], *section[:setting_summary].first(2)].compact %>
                <% hidden_meta = section[:setting_summary].drop(2) %>
                <% if visible_meta.any? || hidden_meta.any? %>
                  <div class="flex min-w-0 items-center gap-1 text-xs text-secondary">
                    <span class="min-w-0 truncate"><%= visible_meta.join(" · ") %></span>
                    <% if hidden_meta.any? %>
                      <details class="relative shrink-0">
                        <summary class="cursor-pointer list-none rounded-md px-1 focus-ring [&::-webkit-details-marker]:hidden" aria-label="<%= t("pages.dashboard.settings.more_summary", count: hidden_meta.size) %>">+<%= hidden_meta.size %></summary>
                        <div class="absolute left-0 top-full z-20 mt-1 w-56 rounded-lg border border-primary bg-surface p-2 shadow-border-xs">
                          <ul class="space-y-1" role="list"><% hidden_meta.each do |summary| %><li><%= summary %></li><% end %></ul>
                        </div>
                      </details>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>

            <div class="flex items-center gap-1">
              <% if section[:legacy_key] == "balance_sheet" && !section[:unavailable] && section[:locals][:balance_sheet].classification_groups.any? { |group| group.account_groups.any? } %>
                <button type="button"
                        class="flex h-6 w-6 items-center justify-center rounded-md text-secondary opacity-0 transition-colors hover:bg-container-inset-hover hover:text-primary focus-ring group-focus-within:opacity-100 group-hover:opacity-100 pointer-coarse:h-11 pointer-coarse:w-11 pointer-coarse:opacity-100"
                        data-balance-sheet-expand-all="true"
                        data-expand-label="<%= t("pages.dashboard.balance_sheet.expand_all") %>"
                        data-collapse-label="<%= t("pages.dashboard.balance_sheet.collapse_all") %>"
                        aria-expanded="false"
                        aria-label="<%= t("pages.dashboard.balance_sheet.expand_all") %>">
                  <span data-icon="expand" aria-hidden="true"><%= icon("chevrons-up-down", size: "sm") %></span>
                  <span data-icon="collapse" aria-hidden="true" hidden><%= icon("chevrons-down-up", size: "sm") %></span>
                </button>
              <% end %>

              <% if section[:legacy_key] == "cashflow_sankey" && !section[:unavailable] && section[:locals][:sankey_data][:links].present? %>
                <button type="button"
                        class="flex h-6 w-6 items-center justify-center rounded-md text-secondary opacity-0 transition-colors hover:bg-container-inset-hover hover:text-primary focus-ring group-focus-within:opacity-100 group-hover:opacity-100 pointer-coarse:h-11 pointer-coarse:w-11 pointer-coarse:opacity-100"
                        data-action="click->cashflow-expand#open"
                        aria-label="<%= t("global.expand") %>">
                  <%= icon("maximize-2", size: "sm") %>
                </button>
              <% end %>

              <% if section[:settings].any? %>
                <%= render "pages/dashboard/widget_settings", settings: section[:settings], update_url: section[:update_url], instance_id: section[:instance_id] %>
              <% end %>

              <% layout = section[:layout] %>
              <%= render DS::Popover.new(variant: :icon, icon: "more-horizontal", placement: "bottom-end", no_padding: true, mobile_fullwidth: false, max_width: "20rem", testid: "dashboard-widget-actions", aria_label: t("pages.dashboard.widgets.actions", title: t(section[:title]))) do |popover| %>
                <% popover.with_custom_content do %>
                  <div class="w-64 p-2">
                    <% if section[:workspace_url] %>
                      <%= link_to section[:workspace_url], class: "flex min-h-11 w-full items-center gap-2 rounded-md px-2 text-sm text-primary hover:bg-container-hover focus-ring", data: { turbo_frame: "_top", testid: "open-investment-workspace" } do %>
                        <%= icon("maximize-2", size: "sm") %><span><%= t("pages.dashboard.widgets.open_workspace", title: t(section[:title])) %></span>
                      <% end %>
                    <% end %>
                    <button type="button"
                            class="flex min-h-11 w-full items-center gap-2 rounded-md px-2 text-left text-sm text-primary hover:bg-container-hover focus-ring"
                            data-action="click->dashboard-pages#duplicateWidget"
                            data-url="<%= section[:duplicate_url] %>"
                            data-widget-key="<%= section[:key] %>"
                            data-widget-settings="<%= section[:raw_settings].to_json %>"
                            data-invalid-settings-message="<%= t("pages.dashboard.widgets.invalid_settings") %>"
                            data-error-target-id="dashboard-page-alert">
                      <%= icon("copy", size: "sm") %><span><%= t("pages.dashboard.widgets.duplicate", title: t(section[:title])) %></span>
                    </button>
                    <% if layout[:width_options].any? || layout[:height_options].any? %>
                      <div class="space-y-2 border-y border-tertiary py-2"
                           data-controller="dashboard-widget-size"
                           data-dashboard-widget-size-url-value="<%= section[:update_url] %>"
                           data-action="keydown->dashboard-widget-size#stopKeydown">
                        <% if layout[:width_options].any? %>
                          <div class="space-y-1.5">
                            <p class="text-xs font-medium text-secondary"><%= t("pages.dashboard.widget_size.width_label") %></p>
                            <%= render DS::SegmentedControl.new(full_width: true, aria_label: t("pages.dashboard.widget_size.width_label")) do |control| %>
                              <% layout[:width_options].each do |width| %>
                                <% control.with_segment(t("pages.dashboard.widget_size.#{width == 12 ? "full" : "half"}"), active: layout[:col_width] == width, data: { action: "dashboard-widget-size#selectWidth", col_width: width }) %>
                              <% end %>
                            <% end %>
                          </div>
                        <% end %>
                        <% if layout[:height_options].any? %>
                          <div class="space-y-1.5">
                            <p class="text-xs font-medium text-secondary"><%= t("pages.dashboard.widget_size.height_label") %></p>
                            <%= render DS::SegmentedControl.new(full_width: true, aria_label: t("pages.dashboard.widget_size.height_label")) do |control| %>
                              <% layout[:height_options].each do |height| %>
                                <% preset = Dashboard::WidgetCatalog.height_preset(height) %>
                                <% control.with_segment(t("pages.dashboard.widget_size.#{preset}"), active: layout[:height] == height, data: { action: "dashboard-widget-size#selectHeight", height_units: height, height_px: Dashboard::WidgetCatalog.height_px(height) }) %>
                              <% end %>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                    <button type="button"
                            class="flex min-h-11 w-full items-center gap-2 rounded-md px-2 text-left text-sm text-destructive hover:bg-container-hover focus-ring"
                            data-action="click->dashboard-pages#removeWidget"
                            data-url="<%= section[:remove_url] %>"
                            data-confirm="<%= t("pages.dashboard.widgets.remove_confirm", title: t(section[:title])) %>"
                            data-error-target-id="dashboard-page-alert">
                      <%= icon("trash-2", size: "sm") %><span><%= t("pages.dashboard.widgets.remove", title: t(section[:title])) %></span>
                    </button>
                  </div>
                <% end %>
              <% end %>

              <button type="button"
                      class="flex h-6 w-6 cursor-grab items-center justify-center rounded-md text-secondary opacity-0 transition-colors hover:text-primary focus-ring group-focus-within:opacity-100 group-hover:opacity-100 pointer-coarse:h-11 pointer-coarse:w-11 pointer-coarse:opacity-100"
                      data-action="touchstart->dashboard-sortable#touchStart touchmove->dashboard-sortable#touchMove touchend->dashboard-sortable#touchEnd touchcancel->dashboard-sortable#touchEnd"
                      aria-label="<%= t("pages.dashboard.drag_to_reorder") %>">
                <%= icon("grip-vertical", size: "sm") %>
              </button>
            </div>
          </div>

          <div class="<%= section[:padded] ? "px-4 py-4" : "py-4" %>" data-dashboard-section-target="content">
            <% if section[:unavailable] %>
              <div class="px-4">
                <%= render "pages/dashboard/widgets/unavailable_state",
                      message: section[:unavailable][:message],
                      href: section[:unavailable][:href],
                      link_text: section[:unavailable][:link_text] %>
              </div>
            <% else %>
              <%= render partial: section[:partial], locals: section[:locals] %>
              <% if section[:legacy_key] == "cashflow_sankey" && preview_features_enabled? %>
                <%= render "pages/dashboard/cashflow_preview", period: @period, legacy_data: section[:locals][:sankey_data], preview_id: "#{section[:instance_id]}-cashflow-preview" %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% end %>
      </div>
    </div>
  <% end %>
<% end %>
