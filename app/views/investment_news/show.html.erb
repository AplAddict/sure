<% content_for :page_title, t(".title") %>
<%= turbo_frame_tag "investment_workspace" do %>
  <div class="mb-6 space-y-1">
    <%= render "investments/subnav", current: :news %>
    <h1 class="text-xl lg:text-3xl font-medium text-primary"><%= t(".title") %></h1>
    <p class="max-w-3xl text-sm text-secondary"><%= t(".subtitle") %></p>
  </div>
  <div class="space-y-3 pb-6 lg:pb-12" data-testid="investment-news">
    <% if @articles.empty? %>
      <%= render DS::EmptyState.new(icon: "newspaper", title: t(".empty_title"), description: t(".empty_description")) %>
    <% else %>
      <% @articles.each do |article| %>
        <article class="rounded-xl bg-container p-4 shadow-border-xs">
          <div class="flex flex-wrap items-center gap-2 text-xs text-secondary">
            <span class="rounded-full bg-container-inset px-2 py-1"><%= article.source %></span>
            <% article.tickers.each do |ticker| %><%= link_to ticker, research_ticker_path(ticker), class: "rounded-full bg-container-inset px-2 py-1 font-mono text-primary hover:underline" %><% end %>
            <% if article.published_at %>
              <%= tag.time t(".ago", time: time_ago_in_words(article.published_at)), datetime: article.published_at.iso8601, title: l(article.published_at, format: :long) %>
            <% else %>
              <span><%= t(".time_unavailable") %></span>
            <% end %>
          </div>
          <%= link_to article.url, target: "_blank", rel: "noopener", class: "mt-3 block text-base font-medium leading-snug text-link hover:underline" do %><%= article.title %><% end %>
        </article>
      <% end %>
    <% end %>
  </div>
<% end %>
