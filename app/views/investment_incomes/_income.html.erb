<%# locals: (review:, premium:, closing:, currency:) %>
<div class="space-y-3">
  <% if review.missing_fx_count.positive? %>
    <p class="rounded-lg bg-container-inset px-4 py-3 text-sm text-secondary" role="status"><%= t("investment_incomes.show.missing_fx", count: review.missing_fx_count) %></p>
  <% end %>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    <%= investment_stat t("investment_incomes.show.dividends"), investment_money(review.total(:dividends), currency) %>
    <%= investment_stat t("investment_incomes.show.interest"), investment_money(review.total(:interest), currency) %>
    <%= investment_stat t("investment_incomes.show.total_income"), investment_money(review.income_total, currency) %>
  </div>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
    <%= investment_stat t("investment_incomes.show.premium_net"), investment_money(premium[:net], currency),
          hint: premium[:net].nil? ? t("investment_incomes.show.premium_unconverted", count: premium[:unconverted]) : t("investment_incomes.show.premium_note", count: premium[:count]) %>
    <%= investment_stat t("investment_incomes.show.premium_collected"), investment_money(premium[:sold_to_open], currency) %>
    <%= investment_stat t("investment_incomes.show.premium_paid"), investment_money(premium[:bought_to_open], currency) %>
    <%= investment_stat t("investment_incomes.show.premium_closing"), investment_money(closing, currency), hint: t("investment_incomes.show.premium_closing_hint") %>
  </div>
</div>
