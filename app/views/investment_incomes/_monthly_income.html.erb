<%# locals: (review:, currency:) %>
<% rows = review.monthly_income %>
<% totals = review.monthly_totals %>
<% if rows.empty? %>
  <p class="text-sm text-secondary"><%= t("investment_incomes.show.monthly_income_empty") %></p>
<% else %>
  <%# Bars are drawn only for months with a known total; a month that could not be totalled is left as a labelled gap, never a zero-height bar. %>
  <% known = rows.map { |row| row.total }.compact %>
  <% peak = known.max.to_d %>
  <% summary = rows.map { |row| "#{l(row.month, format: "%b %Y")}: #{row.total.nil? ? t("investment_incomes.show.month_unavailable") : format_money(Money.new(row.total, currency))}" }.join("; ") %>
  <div class="mb-3 flex h-24 items-end gap-1" role="img" aria-label="<%= summary %>" data-testid="monthly-chart">
    <% rows.each do |row| %>
      <div class="flex h-full min-w-0 flex-1 flex-col items-center justify-end gap-1" data-month="<%= row.month.iso8601 %>" title="<%= l(row.month, format: "%b %Y") %> · <%= row.total.nil? ? t("investment_incomes.show.month_unavailable") : format_money(Money.new(row.total, currency)) %>">
        <% if row.total.nil? %>
          <span class="text-xs text-secondary" aria-hidden="true">—</span>
        <% else %>
          <span class="block w-full rounded-t bg-link" style="height: <%= peak.positive? ? [ (row.total / peak * 100).round, 2 ].max : 2 %>%"></span>
        <% end %>
        <span class="truncate text-[10px] text-secondary" aria-hidden="true"><%= l(row.month, format: "%b") %></span>
      </div>
    <% end %>
  </div>
  <div class="overflow-x-auto rounded-lg bg-container-inset p-1">
    <table class="w-full min-w-[28rem] text-sm">
      <thead>
        <tr class="text-xs uppercase text-secondary">
          <th scope="col" class="px-4 py-2 text-left font-medium"><%= t("investment_incomes.show.month") %></th>
          <th scope="col" class="px-4 py-2 text-right font-medium"><%= t("investment_incomes.show.dividends") %></th>
          <th scope="col" class="px-4 py-2 text-right font-medium"><%= t("investment_incomes.show.interest") %></th>
          <th scope="col" class="px-4 py-2 text-right font-medium"><%= t("investment_incomes.show.total") %></th>
        </tr>
      </thead>
      <tbody class="bg-container">
        <% rows.each do |row| %>
          <tr class="border-t border-tertiary">
            <td class="px-4 py-2 text-primary"><%= l(row.month, format: "%b %Y") %></td>
            <td class="px-4 py-2 text-right"><%= investment_money(row.dividends, currency) %></td>
            <td class="px-4 py-2 text-right"><%= investment_money(row.interest, currency) %></td>
            <td class="px-4 py-2 text-right font-medium"><%= investment_money(row.total, currency) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="bg-container">
        <tr class="border-t-2 border-tertiary font-medium" data-testid="monthly-totals">
          <th scope="row" class="px-4 py-2 text-left text-primary"><%= t("investment_incomes.show.period_total") %></th>
          <td class="px-4 py-2 text-right"><%= investment_money(totals&.dividends, currency) %></td>
          <td class="px-4 py-2 text-right"><%= investment_money(totals&.interest, currency) %></td>
          <td class="px-4 py-2 text-right"><%= investment_money(totals&.total, currency) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
<% end %>
