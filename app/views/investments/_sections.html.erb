<%# locals: (sections:, namespace:, url:, preference_key:) %>
<%# Drag-to-reorder + collapsible sections for an Investments page. Order and
    collapsed state are saved per member. Reuses the Reports section controllers
    (their names are historical), so keyboard and touch reordering come with it.
    Every section is a named partial with explicit locals (section[:partial],
    section[:locals]); section[:flush] drops the content padding for tables and
    lists that draw their own edges. %>
<div data-controller="reports-sortable"
     data-reports-sortable-url-value="<%= url %>"
     data-reports-sortable-preference-key-value="<%= preference_key %>">
<div class="flex justify-end mb-2">
  <button type="button" class="text-xs font-medium text-secondary hover:text-primary hover:underline focus-ring rounded px-1"
          data-action="click->reports-sortable#reset">
    <%= t("investments.sections.reset") %>
  </button>
</div>
<div data-reports-sortable-target="list"
     data-action="dragover->reports-sortable#dragOver drop->reports-sortable#drop"
     role="list" aria-label="<%= t("investments.sections.aria_label") %>">
  <% sections.ordered.each do |section| %>
    <% collapsed = sections.collapsed?(section[:key]) %>
    <section
      class="bg-container rounded-xl shadow-border-xs transition-all mb-6 group focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-900 focus-visible:ring-offset-2"
      data-reports-sortable-target="section"
      data-section-key="<%= section[:key] %>"
      data-controller="reports-section"
      data-reports-section-section-key-value="<%= section[:key] %>"
      data-reports-section-collapsed-value="<%= collapsed %>"
      data-reports-section-url-value="<%= url %>"
      data-reports-section-preference-key-value="<%= preference_key %>"
      draggable="true" tabindex="0" role="listitem"
      aria-label="<%= t("investments.sections.section_label", title: section[:title]) %>"
      data-action="dragstart->reports-sortable#dragStart dragend->reports-sortable#dragEnd keydown->reports-sortable#handleKeyDown">
      <div class="px-4 py-2 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <button type="button" class="text-secondary hover:text-primary transition-colors p-2 -m-1 rounded focus-ring"
                  data-action="click->reports-section#toggle keydown->reports-section#handleToggleKeydown"
                  data-reports-section-target="button"
                  aria-label="<%= t("investments.sections.toggle", title: section[:title]) %>" aria-expanded="<%= !collapsed %>">
            <%= icon("chevron-down", size: "sm", class: "transition-transform", data: { reports_section_target: "chevron" }) %>
          </button>
          <h2 class="text-base font-medium text-primary"><%= section[:title] %></h2>
        </div>
        <button type="button" class="touch-none cursor-grab active:cursor-grabbing text-secondary hover:text-primary transition-colors p-2 -m-1 rounded focus-ring"
                data-reports-sortable-target="handle"
                data-action="touchstart->reports-sortable#touchStart touchmove->reports-sortable#touchMove:!passive touchend->reports-sortable#touchEnd touchcancel->reports-sortable#touchEnd"
                aria-label="<%= t("investments.sections.drag") %>">
          <%= icon("grip-vertical", size: "sm") %>
        </button>
      </div>
      <div class="<%= section[:flush] ? "" : "p-4" %>" data-reports-section-target="content">
        <%= render partial: section[:partial], locals: section[:locals] || {} %>
      </div>
    </section>
  <% end %>
</div>
</div>
